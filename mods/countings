#! /bin/bash

__countings__() {
   
    __counting_pages_r() {
        REPLY="0"
        local args="$*"
        local l_root="$current_dir"
        local l_pattern="*"
        local l_exclude=""
        local l_depth="0"
        local -A l_globals=()
        local str="$args"
        while [[ "$str" =~ ([a-zA-Z0-9_.-]+)=([^\"\'[:space:]]+|\"([^\"]+)\"|\'([^\']+)\') ]]; do
            local key="${BASH_REMATCH[1]}"
            local val="${BASH_REMATCH[4]:-${BASH_REMATCH[3]:-${BASH_REMATCH[2]}}}"
            if [[ "$key" == "root" ]]; then l_root="$val"
            elif [[ "$key" == "pattern" ]]; then l_pattern="$val"
            elif [[ "$key" == "page_label" ]]; then :
            elif [[ "$key" == "exclude" ]]; then l_exclude="$val"
            elif [[ "$key" == "depth" ]]; then l_depth="$val"
            else
                local g_key="${key#globals.}"
                l_globals["$g_key"]="$val"
            fi
            str="${str#*${BASH_REMATCH[0]}}"
        done
        [[ "$l_root" == "." || -z "$l_root" ]] && l_root=""
        local clean_l_root_slug=""
        if [[ -n "$l_root" ]]; then
            local raw_root="${l_root#/}"
            local old_ifs="$IFS"; IFS='/'; local -a r_parts=(); read -ra r_parts <<< "$raw_root"; IFS="$old_ifs"
            local p
            for p in "${r_parts[@]}"; do
                if [[ "$p" =~ ^([0-9]+)\.(.+)$ ]]; then
                    p="${BASH_REMATCH[2]}"
                fi
                if [[ -z "$clean_l_root_slug" ]]; then clean_l_root_slug="${p//\//.}"; else clean_l_root_slug="${clean_l_root_slug}.${p//\//.}"; fi
            done
        fi
        local target_dir="$SOURCEDIR"
        if [[ -n "$l_root" ]]; then
            if [[ "$l_root" == /* ]]; then
                target_dir="$SOURCEDIR${l_root}"
            else
                target_dir="$SOURCEDIR/${l_root//./\/}"
            fi
        fi
        local count=0
        if [[ -d "$target_dir" ]]; then
            local f
            local -a candidate_files=()
            if [[ ( "$l_pattern" == "*" || "$l_pattern" == "*.wiki" ) && ${#_pages[@]} -gt 0 ]]; then
                local p pf
                for p in "${_pages[@]}"; do
                    pf="${PAGE_FILES[$p]:-}"
                    if [[ "$pf" == "$target_dir/"* ]]; then
                        candidate_files+=("$pf")
                    fi
                done
            fi
            if (( ${#candidate_files[@]} == 0 )); then
                local s_globstar=0
                shopt -q globstar && s_globstar=1 || shopt -s globstar
                for f in "$target_dir"/**/$l_pattern; do
                    [[ -f "$f" ]] && candidate_files+=("$f")
                done
                (( s_globstar == 0 )) && shopt -u globstar
            fi

            local -a globals_check_files=()
            for f in "${candidate_files[@]}"; do
                local rel_path="${f#$target_dir/}"
                local slashes="${rel_path//[^\/]/}"
                if (( l_depth > 0 && ${#slashes} >= l_depth )); then continue; fi
                local fname="${f##*/}"
                local fname_no_ext="${fname%.*}"
                if [[ "$fname_no_ext" =~ ^([0-9]+)\.(.+)$ ]]; then
                    fname_no_ext="${BASH_REMATCH[2]}"
                fi
                local rel_dir="${rel_path%/*}"
                [[ "$rel_dir" == "$rel_path" ]] && rel_dir=""
                if [[ -n "$rel_dir" ]]; then
                    local clean_rel_dir=""
                    local old_ifs="$IFS"; IFS='/'; local -a r_parts=(); read -ra r_parts <<< "$rel_dir"; IFS="$old_ifs"
                    local r_part
                    for r_part in "${r_parts[@]}"; do
                        if [[ "$r_part" =~ ^([0-9]+)\.(.+)$ ]]; then
                            r_part="${BASH_REMATCH[2]}"
                        fi
                        if [[ -z "$clean_rel_dir" ]]; then clean_rel_dir="$r_part"
                        else clean_rel_dir="${clean_rel_dir}/${r_part}"; fi
                    done
                    rel_dir="$clean_rel_dir"
                fi
                local slug_key=""
                if [[ -n "$clean_l_root_slug" ]]; then
                    slug_key="${clean_l_root_slug}"
                    [[ -n "$rel_dir" ]] && slug_key+=".${rel_dir//\//.}"
                    slug_key+=".${fname_no_ext}"
                else
                    slug_key="${rel_dir//\//.}"
                    [[ -n "$slug_key" ]] && slug_key+="."
                    slug_key+="${fname_no_ext}"
                fi
                slug_key="${slug_key#.}"
                if [[ -n "$l_exclude" ]]; then
                    local exclude_match=0
                    if [[ "$l_exclude" == *"&&"* ]]; then
                        exclude_match=1
                        local old_ifs="$IFS"; IFS="&"; local -a parts=(); read -ra parts <<< "$l_exclude"; IFS="$old_ifs"
                        local p
                        for p in "${parts[@]}"; do
                            p="${p#"${p%%[![:space:]]*}"}"; p="${p%"${p##*[![:space:]]}"}"
                            [[ -z "$p" ]] && continue
                            local matched_p=0
                            case "$slug_key" in $p) matched_p=1 ;; esac
                            case "$fname" in $p) matched_p=1 ;; esac
                            case "${fname%.*}" in $p) matched_p=1 ;; esac
                            case "$fname_no_ext" in $p) matched_p=1 ;; esac
                            if (( matched_p == 0 )); then
                                exclude_match=0; break
                            fi
                        done
                    else
                        local old_ifs="$IFS"; IFS="|"; local -a parts=(); read -ra parts <<< "$l_exclude"; IFS="$old_ifs"
                        local p
                        for p in "${parts[@]}"; do
                            p="${p#"${p%%[![:space:]]*}"}"; p="${p%"${p##*[![:space:]]}"}"
                            [[ -z "$p" ]] && continue
                            case "$slug_key" in $p) exclude_match=1; break ;; esac
                            case "$fname" in $p) exclude_match=1; break ;; esac
                            case "${fname%.*}" in $p) exclude_match=1; break ;; esac
                            case "$fname_no_ext" in $p) exclude_match=1; break ;; esac
                        done
                    fi
                    (( exclude_match == 1 )) && continue
                fi
                if (( ${#l_globals[@]} == 0 )); then
                    (( count++ ))
                else
                    globals_check_files+=("$f")
                fi
            done

            if (( ${#l_globals[@]} > 0 && ${#globals_check_files[@]} > 0 )); then
                local -A all_file_globals=()
                local gf gk gv
                while IFS=$'\x1F' read -r gf gk gv; do
                    [[ -n "$gf" && -n "$gk" ]] && all_file_globals["${gf}::${gk}"]="$gv"
                done < <(LC_ALL=C awk '
                    FNR == 1 { in_g = 0 }
                    {
                        sub(/\r$/, "")
                        if (!in_g) {
                            if ($0 ~ /^[ \t]*\{\{[ \t]*block\.globals[ \t]*\}\}[ \t]*$/) in_g = 1
                        } else {
                            if ($0 ~ /^[ \t]*\{\{[ \t]*block\.end[ \t]*\}\}[ \t]*$/) { nextfile }
                            if ($0 ~ /^[ \t]*::[ \t]*[a-zA-Z0-9_-]+:/) {
                                s = $0; sub(/^[ \t]*::[ \t]*/, "", s)
                                idx = index(s, ":")
                                k = substr(s, 1, idx - 1)
                                v = substr(s, idx + 1)
                                sub(/^[ \t]+/, "", v)
                                printf "%s\x1F%s\x1F%s\n", FILENAME, k, v
                            }
                        }
                    }
                ' "${globals_check_files[@]}")
                for f in "${globals_check_files[@]}"; do
                    local match=1 gk actual_v req_str
                    for gk in "${!l_globals[@]}"; do
                        actual_v="${all_file_globals["${f}::${gk}"]:-}"
                        if [[ -z "$actual_v" ]]; then match=0; break; fi
                        req_str="${l_globals[$gk]}"
                        if [[ "$req_str" == *"&&"* ]]; then
                            local old_ifs="$IFS"; IFS="&"; local -a req_arr=(); read -ra req_arr <<< "$req_str"; IFS="$old_ifs"
                            local req_v
                            for req_v in "${req_arr[@]}"; do
                                req_v="${req_v#"${req_v%%[![:space:]]*}"}"; req_v="${req_v%"${req_v##*[![:space:]]}"}"
                                [[ -z "$req_v" ]] && continue
                                case "$actual_v" in
                                    $req_v) ;;
                                    *) match=0; break ;;
                                esac
                            done
                        else
                            local old_ifs="$IFS"; IFS="|"; local -a req_arr=(); read -ra req_arr <<< "$req_str"; IFS="$old_ifs"
                            local or_match=0 req_v
                            for req_v in "${req_arr[@]}"; do
                                req_v="${req_v#"${req_v%%[![:space:]]*}"}"; req_v="${req_v%"${req_v##*[![:space:]]}"}"
                                [[ -z "$req_v" ]] && continue
                                case "$actual_v" in
                                    $req_v) or_match=1; break ;;
                                esac
                            done
                            if (( or_match == 0 )); then match=0; break; fi
                        fi
                        (( match == 0 )) && break
                    done
                    (( match == 1 )) && (( count++ ))
                done
            fi
        fi
        REPLY="$count"
        return 0
    }

    __counting_pages() {
        __counting_pages_r "$@"
        printf "%s" "$reply"
    }

    __counting_blocks_r() {
        REPLY="0"
        local b_type="$1"
        shift
        local singular="${b_type%s}"
        local l_root="" l_depth="999" l_page="" l_exclude=""
        if [[ $# -eq 1 && "$1" != *=* ]]; then
            l_page="$1"
        else
            local str="$*"
            while [[ "$str" =~ ([a-zA-Z0-9_.-]+)=([^\"\'[:space:]]+|\"([^\"]+)\"|\'([^\']+)\') ]]; do
                local key="${BASH_REMATCH[1]}"
                local val="${BASH_REMATCH[4]:-${BASH_REMATCH[3]:-${BASH_REMATCH[2]}}}"
                if [[ "$key" == "root" ]]; then l_root="$val"
                elif [[ "$key" == "depth" ]]; then l_depth="$val"
                elif [[ "$key" == "page" ]]; then l_page="$val"
                elif [[ "$key" == "exclude" ]]; then l_exclude="$val"
                fi
                str="${str#*${BASH_REMATCH[0]}}"
            done
        fi
        local -a target_files=()
        if [[ -n "$l_page" ]]; then
            local t_file="$SOURCEDIR/${l_page//./\/}"
            if [[ -f "${t_file}.md" ]]; then target_files+=("${t_file}.md")
            elif [[ -f "${t_file}.wiki" ]]; then target_files+=("${t_file}.wiki")
            elif [[ -f "$t_file" ]]; then target_files+=("$t_file")
            fi
        elif [[ -n "$l_root" ]]; then
            local t_dir="${SOURCEDIR%/}"
            if [[ "$l_root" == /* ]]; then
                t_dir="${t_dir}${l_root}"
            else
                t_dir="${t_dir}/${l_root//./\/}"
            fi
            if [[ -d "$t_dir" ]]; then
                local p p_f rel d_count
                for p in "${_pages[@]}"; do
                    p_f="${PAGE_FILES[$p]:-}"
                    if [[ "$p_f" == "$t_dir/"* ]]; then
                        rel="${p_f#$t_dir/}"
                        d_count="${rel//[^\/]/}"
                        if (( ${#d_count} < l_depth )); then
                            target_files+=("$p_f")
                        fi
                    fi
                done
                if (( ${#target_files[@]} == 0 )); then
                    while IFS= read -r -d '' f; do
                        rel="${f#$t_dir/}"
                        d_count="${rel//[^\/]/}"
                        if (( ${#d_count} < l_depth )); then
                            target_files+=("$f")
                        fi
                    done < <(find "$t_dir" -type f -name "*.wiki" -print0)
                fi
            fi
        else
            target_files+=("$file")
        fi
        local -a filtered_files=()
        local t_f
        for t_f in "${target_files[@]}"; do
            [[ -f "$t_f" ]] || continue
            if [[ -n "$l_exclude" ]]; then
                local t_rel="${t_f#$SOURCEDIR/}"
                local fname="${t_f##*/}"
                local fname_no_ext="${fname%.*}"
                if [[ "$fname_no_ext" =~ ^([0-9]+)\.(.+)$ ]]; then
                    fname_no_ext="${BASH_REMATCH[2]}"
                fi
                local rel_dir="${t_rel%/*}"
                [[ "$rel_dir" == "$t_rel" ]] && rel_dir=""
                if [[ -n "$rel_dir" ]]; then
                    local clean_rel_dir=""
                    local old_ifs="$IFS"; IFS='/'; local -a r_parts=(); read -ra r_parts <<< "$rel_dir"; IFS="$old_ifs"
                    for r_part in "${r_parts[@]}"; do
                        if [[ "$r_part" =~ ^([0-9]+)\.(.+)$ ]]; then
                            r_part="${BASH_REMATCH[2]}"
                        fi
                        if [[ -z "$clean_rel_dir" ]]; then clean_rel_dir="$r_part"
                        else clean_rel_dir="${clean_rel_dir}/${r_part}"; fi
                    done
                    rel_dir="$clean_rel_dir"
                fi
                local slug_key="${rel_dir//\//.}"
                [[ -n "$slug_key" ]] && slug_key+="."
                slug_key+="${fname_no_ext}"
                slug_key="${slug_key#.}"
                local exclude_match=0
                if [[ "$l_exclude" == *"&&"* ]]; then
                    exclude_match=1
                    local old_ifs="$IFS"; IFS="&"; local -a parts=(); read -ra parts <<< "$l_exclude"; IFS="$old_ifs"
                    for p in "${parts[@]}"; do
                        p="${p#"${p%%[![:space:]]*}"}"; p="${p%"${p##*[![:space:]]}"}"
                        [[ -z "$p" ]] && continue
                        local matched_p=0
                        case "$slug_key" in $p) matched_p=1 ;; esac
                        case "$fname" in $p) matched_p=1 ;; esac
                        case "${fname%.*}" in $p) matched_p=1 ;; esac
                        case "$fname_no_ext" in $p) matched_p=1 ;; esac
                        if (( matched_p == 0 )); then
                            exclude_match=0; break
                        fi
                    done
                else
                    local old_ifs="$IFS"; IFS=$'\x7c'; local -a parts=(); read -ra parts <<< "$l_exclude"; IFS="$old_ifs"
                    for p in "${parts[@]}"; do
                        p="${p#"${p%%[![:space:]]*}"}"; p="${p%"${p##*[![:space:]]}"}"
                        [[ -z "$p" ]] && continue
                        case "$slug_key" in $p) exclude_match=1; break ;; esac
                        case "$fname" in $p) exclude_match=1; break ;; esac
                        case "${fname%.*}" in $p) exclude_match=1; break ;; esac
                        case "$fname_no_ext" in $p) exclude_match=1; break ;; esac
                    done
                fi
                (( exclude_match == 1 )) && continue
            fi
            filtered_files+=("$t_f")
        done
        local total_blocks=0
        if (( ${#filtered_files[@]} > 0 )); then
            total_blocks="$(LC_ALL=C awk -v b_type="$b_type" -v singular="$singular" '
                BEGIN { c = 0 }
                FNR == 1 { in_b = ""; nest = 0 }
                /block\./ {
                    sub(/\r$/, "")
                    if (in_b == "") {
                        if ($0 ~ /^[ \t]*\{\{[ \t]*block\.[a-zA-Z0-9_-]+[ \t]*\}\}[ \t]*$/) {
                            m = $0
                            sub(/^[ \t]*\{\{[ \t]*block\./, "", m)
                            sub(/[ \t]*\}\}[ \t]*$/, "", m)
                            if (m == b_type) { in_b = m; nest = 0 }
                            else if (m == singular) { in_b = m; nest = 0 }
                            else if ((m "s") == b_type) { in_b = m; nest = 0 }
                        }
                    } else {
                        c_line = $0
                        sub(/^[ \t]*::[ \t]*/, "", c_line)
                        if (c_line ~ /^[ \t]*\{\{[ \t]*block\.end[ \t]*\}\}[ \t]*$/) {
                            if (nest > 0) nest--
                            else { c++; in_b = "" }
                        } else if (c_line ~ /^[ \t]*\{\{[ \t]*block\.[a-zA-Z0-9_-]+.*\}\}[ \t]*$/) {
                            nest++
                        }
                    }
                }
                END { print c }
            ' "${filtered_files[@]}")"
        fi
        REPLY="${total_blocks:-0}"
        return 0
    }   

    __counting_blocks() {
        __counting_blocks_r "$@"
        printf "%s" "$reply"
    }
}
