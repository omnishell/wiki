#! /bin/bash

__listings__() {

    __listing_pages_r() {
        REPLY=""
        local args="$*"
        local l_root="$current_dir"
        local l_pattern="*"
        local l_page_label="title"
        local l_exclude=""
        local l_depth="0"
        local -A l_globals=()
        local str="$args"
        while [[ "$str" =~ ([a-zA-Z0-9_.-]+)=([^\"\'[:space:]]+|\"([^\"]+)\"|\'([^\']+)\') ]]; do
            local key="${BASH_REMATCH[1]}"
            local val="${BASH_REMATCH[4]:-${BASH_REMATCH[3]:-${BASH_REMATCH[2]}}}"
            if [[ "$key" == "root" ]]; then l_root="$val"
            elif [[ "$key" == "pattern" ]]; then l_pattern="$val"
            elif [[ "$key" == "page_label" ]]; then l_page_label="$val"
            elif [[ "$key" == "exclude" ]]; then l_exclude="$val"
            elif [[ "$key" == "depth" ]]; then l_depth="$val"
            else
                local g_key="${key#globals.}"
                l_globals["$g_key"]="$val"
            fi
            str="${str#*${BASH_REMATCH[0]}}"
        done
        [[ "$l_root" == "." || -z "$l_root" ]] && l_root=""

        local clean_l_root_slug=""
        local clean_l_root_url=""
        if [[ -n "$l_root" ]]; then
            local raw_root="${l_root#/}"
            local old_ifs="$IFS"; IFS='/'; local -a r_parts=(); read -ra r_parts <<< "$raw_root"; IFS="$old_ifs"
            local p
            for p in "${r_parts[@]}"; do
                if [[ "$p" =~ ^([0-9]+)\.(.+)$ ]]; then
                    p="${BASH_REMATCH[2]}"
                fi
                if [[ -z "$clean_l_root_slug" ]]; then clean_l_root_slug="${p//\//.}"; else clean_l_root_slug="${clean_l_root_slug}.${p//\//.}"; fi
                local u_part="${p//./\/}"
                if [[ -z "$clean_l_root_url" ]]; then clean_l_root_url="$u_part"; else clean_l_root_url="${clean_l_root_url}/${u_part}"; fi
            done
            [[ "$l_root" == /* ]] && clean_l_root_url="/$clean_l_root_url"
        fi
        local list_html="<list class=\"list-pages\">"$'\n'"<ul class=\"list-pages-ul\">"$'\n'
        local target_dir="$SOURCEDIR"
        if [[ -n "$l_root" ]]; then
            if [[ "$l_root" == /* ]]; then
                target_dir="$SOURCEDIR${l_root}"
            else
                target_dir="$SOURCEDIR/${l_root//./\/}"
            fi
        fi
        if [[ -d "$target_dir" ]]; then
            local f
            local force_globals=0
            [[ "$l_page_label" == globals.* ]] && force_globals=1
            local -a candidate_files=()
            if [[ ( "$l_pattern" == "*" || "$l_pattern" == "*.wiki" ) && ${#_pages[@]} -gt 0 ]]; then
                local p pf
                for p in "${_pages[@]}"; do
                    pf="${PAGE_FILES[$p]:-}"
                    if [[ "$pf" == "$target_dir/"* ]]; then
                        candidate_files+=("$pf")
                    fi
                done
            fi
            if (( ${#candidate_files[@]} == 0 )); then
                local s_globstar=0
                shopt -q globstar && s_globstar=1 || shopt -s globstar
                for f in "$target_dir"/**/$l_pattern; do
                    [[ -f "$f" ]] && candidate_files+=("$f")
                done
                (( s_globstar == 0 )) && shopt -u globstar
            fi

            local -a matching_slugs=()
            local -A file_disp_names=()
            local -A file_weights=()
            local -A dir_implicit_weights=()
            local -A cand_slug_map=() cand_rel_map=() cand_fname_map=()
            local -a globals_check_files=()

            for f in "${candidate_files[@]}"; do
                local rel_path="${f#$target_dir/}"
                local slashes="${rel_path//[^\/]/}"
                if (( l_depth > 0 && ${#slashes} >= l_depth )); then continue; fi
                local fname="${f##*/}"
                local fname_no_ext="${fname%.*}"
                if [[ "$fname_no_ext" =~ ^([0-9]+)\.(.+)$ ]]; then
                    fname_no_ext="${BASH_REMATCH[2]}"
                fi
                local rel_dir="${rel_path%/*}"
                [[ "$rel_dir" == "$rel_path" ]] && rel_dir=""

                if [[ -n "$rel_dir" ]]; then
                    local clean_rel_dir=""
                    local old_ifs="$IFS"; IFS='/'; local -a r_parts=(); read -ra r_parts <<< "$rel_dir"; IFS="$old_ifs"
                    local r_part
                    for r_part in "${r_parts[@]}"; do
                        local current_weight="9999999"
                        if [[ "$r_part" =~ ^([0-9]+)\.(.+)$ ]]; then
                            current_weight="${BASH_REMATCH[1]}"
                            r_part="${BASH_REMATCH[2]}"
                        fi
                        if [[ -z "$clean_rel_dir" ]]; then clean_rel_dir="$r_part"
                        else clean_rel_dir="${clean_rel_dir}/${r_part}"; fi

                        local temp_slug_key=""
                        if [[ -n "$clean_l_root_slug" ]]; then temp_slug_key="${clean_l_root_slug}.${clean_rel_dir//\//.}"; else temp_slug_key="${clean_rel_dir//\//.}"; fi
                        temp_slug_key="${temp_slug_key#.}"

                        if [[ "$current_weight" != "9999999" ]]; then
                            dir_implicit_weights["$temp_slug_key"]="$current_weight"
                        fi
                    done
                    rel_dir="$clean_rel_dir"
                fi

                local slug_key=""
                if [[ -n "$clean_l_root_slug" ]]; then
                    slug_key="${clean_l_root_slug}"
                    [[ -n "$rel_dir" ]] && slug_key+=".${rel_dir//\//.}"
                    slug_key+=".${fname_no_ext}"
                else
                    slug_key="${rel_dir//\//.}"
                    [[ -n "$slug_key" ]] && slug_key+="."
                    slug_key+="${fname_no_ext}"
                fi
                slug_key="${slug_key#.}"

                if [[ -n "$l_exclude" ]]; then
                    local exclude_match=0
                    if [[ "$l_exclude" == *"&&"* ]]; then
                        exclude_match=1
                        local old_ifs="$IFS"; IFS="&"; local -a parts=(); read -ra parts <<< "$l_exclude"; IFS="$old_ifs"
                        local p
                        for p in "${parts[@]}"; do
                            p="${p#"${p%%[![:space:]]*}"}"; p="${p%"${p##*[![:space:]]}"}"
                            [[ -z "$p" ]] && continue
                            local matched_p=0
                            case "$slug_key" in $p) matched_p=1 ;; esac
                            case "$fname" in $p) matched_p=1 ;; esac
                            case "${fname%.*}" in $p) matched_p=1 ;; esac
                            case "$fname_no_ext" in $p) matched_p=1 ;; esac
                            if (( matched_p == 0 )); then
                                exclude_match=0; break
                            fi
                        done
                    else
                        local old_ifs="$IFS"; IFS="|"; local -a parts=(); read -ra parts <<< "$l_exclude"; IFS="$old_ifs"
                        local p
                        for p in "${parts[@]}"; do
                            p="${p#"${p%%[![:space:]]*}"}"; p="${p%"${p##*[![:space:]]}"}"
                            [[ -z "$p" ]] && continue
                            case "$slug_key" in $p) exclude_match=1; break ;; esac
                            case "$fname" in $p) exclude_match=1; break ;; esac
                            case "${fname%.*}" in $p) exclude_match=1; break ;; esac
                            case "$fname_no_ext" in $p) exclude_match=1; break ;; esac
                        done
                    fi
                    (( exclude_match == 1 )) && continue
                fi

                local rel_slug="${rel_dir:+$rel_dir/}${fname_no_ext}"
                cand_slug_map["$f"]="$slug_key"
                cand_rel_map["$f"]="$rel_slug"
                cand_fname_map["$f"]="$fname_no_ext"
                globals_check_files+=("$f")
            done

            local -A all_file_globals=()
            if (( ( ${#l_globals[@]} > 0 || force_globals == 1 ) && ${#globals_check_files[@]} > 0 )); then
                local gf gk gv
                while IFS=$'\x1F' read -r gf gk gv; do
                    [[ -n "$gf" && -n "$gk" ]] && all_file_globals["${gf}::${gk}"]="$gv"
                done < <(LC_ALL=C awk '
                    FNR == 1 { in_g = 0 }
                    {
                        sub(/\r$/, "")
                        if (!in_g) {
                            if ($0 ~ /^[ \t]*\{\{[ \t]*block\.globals[ \t]*\}\}[ \t]*$/) in_g = 1
                        } else {
                            if ($0 ~ /^[ \t]*\{\{[ \t]*block\.end[ \t]*\}\}[ \t]*$/) { nextfile }
                            if ($0 ~ /^[ \t]*::[ \t]*[a-zA-Z0-9_-]+:/) {
                                s = $0; sub(/^[ \t]*::[ \t]*/, "", s)
                                idx = index(s, ":")
                                k = substr(s, 1, idx - 1)
                                v = substr(s, idx + 1)
                                sub(/^[ \t]+/, "", v)
                                printf "%s\x1F%s\x1F%s\n", FILENAME, k, v
                            }
                        }
                    }
                ' "${globals_check_files[@]}")
            fi

            for f in "${globals_check_files[@]}"; do
                local match=1
                if (( ${#l_globals[@]} > 0 )); then
                    local gk actual_v req_str
                    for gk in "${!l_globals[@]}"; do
                        actual_v="${all_file_globals["${f}::${gk}"]:-}"
                        if [[ -z "$actual_v" ]]; then match=0; break; fi
                        req_str="${l_globals[$gk]}"

                        if [[ "$req_str" == *"&&"* ]]; then
                            local old_ifs="$IFS"; IFS="&"; local -a req_arr=(); read -ra req_arr <<< "$req_str"; IFS="$old_ifs"
                            local req_v
                            for req_v in "${req_arr[@]}"; do
                                req_v="${req_v#"${req_v%%[![:space:]]*}"}"; req_v="${req_v%"${req_v##*[![:space:]]}"}"
                                [[ -z "$req_v" ]] && continue
                                case "$actual_v" in
                                    $req_v) ;;
                                    *) match=0; break ;;
                                esac
                            done
                        else
                            local old_ifs="$IFS"; IFS="|"; local -a req_arr=(); read -ra req_arr <<< "$req_str"; IFS="$old_ifs"
                            local or_match=0 req_v
                            for req_v in "${req_arr[@]}"; do
                                req_v="${req_v#"${req_v%%[![:space:]]*}"}"; req_v="${req_v%"${req_v##*[![:space:]]}"}"
                                [[ -z "$req_v" ]] && continue
                                case "$actual_v" in
                                    $req_v) or_match=1; break ;;
                                esac
                            done
                            if (( or_match == 0 )); then match=0; break; fi
                        fi
                        (( match == 0 )) && break
                    done
                fi
                if (( match == 1 )); then
                    local slug_key="${cand_slug_map[$f]}"
                    local rel_slug="${cand_rel_map[$f]}"
                    local fname_no_ext="${cand_fname_map[$f]}"
                    local disp_name=""
                    if [[ "$l_page_label" == globals.* ]]; then
                        local g_key="${l_page_label#globals.}"
                        disp_name="${all_file_globals["${f}::${g_key}"]:-}"
                    elif [[ "$l_page_label" == "name" ]]; then
                        disp_name="${fname_no_ext}"
                    elif [[ "$l_page_label" == "weight" ]]; then
                        disp_name="${PAGE_WEIGHTS[$slug_key]:-9999999}"
                    fi
                    [[ -z "$disp_name" ]] && disp_name="${PAGE_TITLES[$slug_key]:-${fname_no_ext}}"
                    matching_slugs+=("$rel_slug")
                    file_disp_names["$rel_slug"]="$disp_name"
                    file_weights["$rel_slug"]="${PAGE_WEIGHTS[$slug_key]:-9999999}"
                fi
            done

            if (( ${#matching_slugs[@]} > 0 )); then
                local -a raw_sorted=()
                local rel_slug
                for rel_slug in "${matching_slugs[@]}"; do
                    local old_ifs="$IFS"; IFS='/'; local -a parts=(); read -ra parts <<< "$rel_slug"; IFS="$old_ifs"

                    local sort_key=""
                    local cum_path=""
                    local i
                    for (( i=0; i<${#parts[@]}; i++ )); do
                        local part="${parts[$i]}"
                        if [[ -z "$cum_path" ]]; then cum_path="$part"; else cum_path="${cum_path}/${part}"; fi
                        local w type
                        if (( i == ${#parts[@]} - 1 )); then
                            type="1"
                            w="${file_weights[$rel_slug]:-9999999}"
                        else
                            type="0"
                            local dir_slug_key=""
                            if [[ -n "$clean_l_root_slug" ]]; then dir_slug_key="${clean_l_root_slug}.${cum_path//\//.}"; else dir_slug_key="${cum_path//\//.}"; fi
                            dir_slug_key="${dir_slug_key#.}"
                            w="${PAGE_WEIGHTS[$dir_slug_key]:-9999999}"
                            [[ "$w" == "9999999" ]] && w="${dir_implicit_weights[$dir_slug_key]:-9999999}"
                        fi
                        w="0000000${w}"
                        w="${w: -7}"
                        sort_key+="/${type}_${w}_${part}"
                    done
                    raw_sorted+=("${sort_key}|${rel_slug}")
                done
                local -a sorted_slugs=()
                local line
                while IFS= read -r line; do
                    sorted_slugs+=("${line#*|}")
                done < <(printf "%s\n" "${raw_sorted[@]}" | LC_ALL=C sort -t'|' -k1,1)
                local -a current_path=()
                for rel_slug in "${sorted_slugs[@]}"; do
                    local old_ifs="$IFS"; IFS='/'; local -a parts=(); read -ra parts <<< "$rel_slug"; IFS="$old_ifs"
                    local -a dir_parts=("${parts[@]:0:${#parts[@]}-1}")
                    local common_len=0
                    while [[ $common_len -lt ${#current_path[@]} && $common_len -lt ${#dir_parts[@]} && "${current_path[$common_len]}" == "${dir_parts[$common_len]}" ]]; do
                        (( common_len++ ))
                    done
                    local i
                    for (( i=${#current_path[@]}-1; i>=common_len; i-- )); do
                        list_html+="</ul></li>"$'\n'
                    done
                    local cum_dir=""
                    for (( i=0; i<${#dir_parts[@]}; i++ )); do
                        local dir="${dir_parts[$i]}"
                        if [[ -z "$cum_dir" ]]; then cum_dir="$dir"; else cum_dir="${cum_dir}/${dir}"; fi
                        if (( i >= common_len )); then
                            local dir_slug_key=""
                            if [[ -n "$clean_l_root_slug" ]]; then dir_slug_key="${clean_l_root_slug}.${cum_dir//\//.}"; else dir_slug_key="${cum_dir//\//.}"; fi
                            dir_slug_key="${dir_slug_key#.}"
                            local dir_disp="${PAGE_TITLES[$dir_slug_key]:-$dir}"
                            [[ "$dir_disp" != */ ]] && dir_disp="${dir_disp}/"
                            list_html+="<li class=\"list-pages-dir\">${dir_disp}<ul class=\"list-pages-ul-inner\">"$'\n'
                        fi
                    done
                    local p_url=""
                    if [[ -n "$clean_l_root_url" ]]; then
                        p_url="${clean_l_root_url}/${rel_slug}.html"
                    else
                        p_url="${rel_slug}.html"
                    fi
                    [[ "$p_url" != /* ]] && p_url="/${p_url}"
                    p_url="${p_url//\/\//\/}"
                    local disp_name="${file_disp_names[$rel_slug]}"
                    list_html+="<li class=\"list-pages-li\"><a href=\"$p_url\">$disp_name</a></li>"$'\n'
                    current_path=("${dir_parts[@]}")
                done
                local i
                for (( i=${#current_path[@]}-1; i>=0; i-- )); do
                    list_html+="</ul></li>"$'\n'
                done
            fi
        fi
        list_html+="</ul>"$'\n'"</list>"
        REPLY="$list_html"
        return 0
    }
    
    __listing_pages() {
        __listing_pages_r "$@"
        printf "%s" "$REPLY"
    }

    __listing_blocks_r() {
        REPLY=""
        local b_type="$1"
        shift
        local singular="${b_type%s}"
        local l_root="" l_depth="999" l_page="" l_exclude="" l_context="false"
        if [[ $# -eq 1 && "$1" != *=* ]]; then
            l_page="$1"
        else
            local str="$*"
            while [[ "$str" =~ ([a-zA-Z0-9_.-]+)=([^\"\'[:space:]]+|\"([^\"]+)\"|\'([^\']+)\') ]]; do
                local key="${BASH_REMATCH[1]}"
                local val="${BASH_REMATCH[4]:-${BASH_REMATCH[3]:-${BASH_REMATCH[2]}}}"
                if [[ "$key" == "root" ]]; then l_root="$val"
                elif [[ "$key" == "depth" ]]; then l_depth="$val"
                elif [[ "$key" == "page" ]]; then l_page="$val"
                elif [[ "$key" == "exclude" ]]; then l_exclude="$val"
                elif [[ "$key" == "context" ]]; then l_context="${val,,}"
                fi
                str="${str#*${BASH_REMATCH[0]}}"
            done
        fi
        local flat_list=0
        [[ -z "$l_root" ]] && flat_list=1
        local list_html="<list class=\"list-block-${singular}\">"$'\n'
        if (( flat_list == 1 )); then
            list_html+="<ul class=\"list-block-${singular}-ul\">"$'\n'
        else
            list_html+="<ol class=\"list-block-${singular}-files\">"$'\n'
        fi
        local -a target_files=()
        if [[ -n "$l_page" ]]; then
            local t_file="$SOURCEDIR/${l_page//./\/}"
            if [[ -f "${t_file}.md" ]]; then target_files+=("${t_file}.md")
            elif [[ -f "${t_file}.wiki" ]]; then target_files+=("${t_file}.wiki")
            elif [[ -f "$t_file" ]]; then target_files+=("$t_file")
            fi
        elif [[ -n "$l_root" ]]; then
            local t_dir="${SOURCEDIR%/}"
            if [[ "$l_root" == /* ]]; then
                t_dir="${t_dir}${l_root}"
            else
                t_dir="${t_dir}/${l_root//./\/}"
            fi
            if [[ -d "$t_dir" ]]; then
                local p p_f rel d_count
                for p in "${_pages[@]}"; do
                    p_f="${PAGE_FILES[$p]:-}"
                    if [[ "$p_f" == "$t_dir/"* ]]; then
                        rel="${p_f#$t_dir/}"
                        d_count="${rel//[^\/]/}"
                        if (( ${#d_count} < l_depth )); then
                            target_files+=("$p_f")
                        fi
                    fi
                done
                if (( ${#target_files[@]} == 0 )); then
                    while IFS= read -r -d '' f; do
                        rel="${f#$t_dir/}"
                        d_count="${rel//[^\/]/}"
                        if (( ${#d_count} < l_depth )); then
                            target_files+=("$f")
                        fi
                    done < <(find "$t_dir" -type f -name "*.wiki" -print0)
                fi
            fi
        else
            target_files+=("$file")
        fi
        local n_tf=${#target_files[@]}
        if (( n_tf > 1 )); then
            local i j tmp_f
            for (( i=1; i<n_tf; i++ )); do
                tmp_f="${target_files[i]}"
                j=$(( i - 1 ))
                while (( j >= 0 )) && [[ "${target_files[j]}" > "$tmp_f" ]]; do
                    target_files[j+1]="${target_files[j]}"
                    (( j-- ))
                done
                target_files[j+1]="$tmp_f"
            done
        fi
        local -a filtered_files=()
        local -A file_t_url=()
        local -A file_disp_path=()
        local t_f old_ifs="$IFS"
        for t_f in "${target_files[@]}"; do
            [[ -f "$t_f" ]] || continue
            local t_rel="${t_f#$SOURCEDIR/}"
            local fname="${t_f##*/}"
            local fname_no_ext="${fname%.*}"
            if [[ "$fname_no_ext" =~ ^([0-9]+)\.(.+)$ ]]; then
                fname_no_ext="${BASH_REMATCH[2]}"
            fi
            local rel_dir="${t_rel%/*}"
            [[ "$rel_dir" == "$t_rel" ]] && rel_dir=""
            if [[ -n "$rel_dir" ]]; then
                local clean_rel_dir=""
                set -f
                IFS='/'
                local -a r_parts=($rel_dir)
                IFS="$old_ifs"
                set +f
                local r_part
                for r_part in "${r_parts[@]}"; do
                    if [[ "$r_part" =~ ^([0-9]+)\.(.+)$ ]]; then
                        r_part="${BASH_REMATCH[2]}"
                    fi
                    if [[ -z "$clean_rel_dir" ]]; then clean_rel_dir="$r_part"
                    else clean_rel_dir="${clean_rel_dir}/${r_part}"; fi
                done
                rel_dir="$clean_rel_dir"
            fi
            local t_url=""
            if [[ -n "$rel_dir" ]]; then
                t_url="/${rel_dir}/${fname_no_ext}.html"
            else
                t_url="/${fname_no_ext}.html"
            fi
            local slug_key="${rel_dir//\//.}"
            [[ -n "$slug_key" ]] && slug_key+="."
            slug_key+="${fname_no_ext}"
            slug_key="${slug_key#.}"
            if [[ -n "$l_exclude" ]]; then
                local exclude_match=0
                if [[ "$l_exclude" == *"&&"* ]]; then
                    exclude_match=1
                    IFS="&"; local -a parts=(); read -ra parts <<< "$l_exclude"; IFS="$old_ifs"
                    local p
                    for p in "${parts[@]}"; do
                        p="${p#"${p%%[![:space:]]*}"}"; p="${p%"${p##*[![:space:]]}"}"
                        [[ -z "$p" ]] && continue
                        local matched_p=0
                        case "$slug_key" in $p) matched_p=1 ;; esac
                        case "$fname" in $p) matched_p=1 ;; esac
                        case "${fname%.*}" in $p) matched_p=1 ;; esac
                        case "$fname_no_ext" in $p) matched_p=1 ;; esac
                        if (( matched_p == 0 )); then
                            exclude_match=0; break
                        fi
                    done
                else
                    IFS=$'\x7c'; local -a parts=(); read -ra parts <<< "$l_exclude"; IFS="$old_ifs"
                    local p
                    for p in "${parts[@]}"; do
                        p="${p#"${p%%[![:space:]]*}"}"; p="${p%"${p##*[![:space:]]}"}"
                        [[ -z "$p" ]] && continue
                        case "$slug_key" in $p) exclude_match=1; break ;; esac
                        case "$fname" in $p) exclude_match=1; break ;; esac
                        case "${fname%.*}" in $p) exclude_match=1; break ;; esac
                        case "$fname_no_ext" in $p) exclude_match=1; break ;; esac
                    done
                fi
                (( exclude_match == 1 )) && continue
            fi
            filtered_files+=("$t_f")
            file_t_url["$t_f"]="$t_url"
            file_disp_path["$t_f"]="${rel_dir:+$rel_dir/}${fname_no_ext}"
        done
        if (( ${#filtered_files[@]} > 0 )); then
            local -A file_html_map=()
            local awk_f awk_li
            while IFS=$'\x1f' read -r awk_f awk_li; do
                [[ -z "$awk_f" ]] && continue
                local u="${file_t_url[$awk_f]}"
                file_html_map["$awk_f"]+="            ${awk_li//%%T_URL%%/$u}"$'\n'
            done < <(LC_ALL=C awk -v b_type="$b_type" -v singular="$singular" -v l_context="$l_context" '
                function slugify(s) {
                    s = tolower(s)
                    gsub(/ /, "-", s)
                    gsub(/\xc3[\xa0-\xa4\x80-\x84]/, "a", s)
                    gsub(/\xc3[\xa8-\xab\x88-\x8b]/, "e", s)
                    gsub(/\xc3[\xac-\xaf\x8c-\x8f]/, "i", s)
                    gsub(/\xc3[\xb2-\xb6\x92-\x96]/, "o", s)
                    gsub(/\xc3[\xb9-\xbc\x99-\x9c]/, "u", s)
                    gsub(/\xc3[\xa7\x87]/, "c", s)
                    gsub(/\xc3[\xb1\x91]/, "n", s)
                    gsub(/[^a-z0-9_./-]/, "", s)
                    if (s ~ /^-[neE]+$/) s = ""
                    return s
                }
                BEGIN {
                    id_key = "__id" "__"
                    ctx_key = "__context" "__"
                    ent_key = "__entity" "__"
                    entry_key = "__entry" "__"
                }
                FNR == 1 {
                    in_block = ""; nest = 0; item_count_table = 0; item_count_diagram = 0
                }
                {
                    sub(/\r$/, "")
                    if (in_block == "") {
                        if ($0 ~ /^[ \t]*\{\{[ \t]*block\.[a-zA-Z0-9_-]+[ \t]*\}\}[ \t]*$/) {
                            m = $0
                            sub(/^[ \t]*\{\{[ \t]*block\./, "", m)
                            sub(/[ \t]*\}\}[ \t]*$/, "", m)
                            if (m == "table") item_count_table++
                            if (m == "diagram") item_count_diagram++
                            is_match = 0
                            if (m == b_type) is_match = 1
                            else if (m == singular) is_match = 1
                            else if ((m "s") == b_type) is_match = 1
                            if (is_match) {
                                in_block = m; nest = 0
                                block_id = ""; first_key = ""; first_val = ""; b_context = ""; b_entity = ""
                                t_len = 0
                            }
                        }
                    } else {
                        c_line = $0
                        sub(/^[ \t]*::[ \t]*/, "", c_line)
                        if (c_line ~ /^[ \t]*\{\{[ \t]*block\.end[ \t]*\}\}[ \t]*$/) {
                            if (nest > 0) { nest--; next }
                            if (in_block == "table") {
                                caption = ""; sep_count = 0
                                for (i = 1; i <= t_len; i++) {
                                    if (t_buf[i] ~ /^[-=_]{4,}/) sep_count++
                                }
                                if (sep_count >= 2) {
                                    found_sep = 0
                                    for (i = 1; i <= t_len; i++) {
                                        if (t_buf[i] ~ /^[-=_]{4,}/) { found_sep++; continue }
                                        if (found_sep == sep_count) {
                                            cl = t_buf[i]
                                            sub(/^[ \t]+/, "", cl); sub(/[ \t]+$/, "", cl)
                                            if (cl != "") { caption = cl; break }
                                        }
                                    }
                                }
                                cap_txt = (caption != "" ? caption : "Table " item_count_table)
                                print FILENAME "\x1f<li class=\"list-block-" singular "-li\"><a href=\"%%T_URL%%#table-" item_count_table "\">" cap_txt "</a></li>"
                            } else if (in_block == "diagram") {
                                print FILENAME "\x1f<li class=\"list-block-" singular "-li\"><a href=\"%%T_URL%%#diagram-" item_count_diagram "\">Diagram " item_count_diagram "</a></li>"
                            } else {
                                pre_ctx = ""
                                link_txt = (singular == "def" ? first_val : (b_entity != "" ? b_entity : first_val))
                                if (b_context != "" && l_context == "true") pre_ctx = b_context ": "
                                raw_id = (block_id != "" ? block_id : (b_entity != "" ? b_entity : first_val))
                                clean_id = slugify(raw_id)
                                ref_key = clean_id
                                if (b_context != "" && index(raw_id, ".") == 0) {
                                    ref_key = slugify(b_context "." raw_id)
                                }
                                anc_slug = ref_key
                                gsub(/[\/.]/, "-", anc_slug)
                                anc_id = "block-" in_block "-" anc_slug
                                if (link_txt == "") link_txt = anc_id
                                print FILENAME "\x1f<li class=\"list-block-" singular "-li\">" pre_ctx "<a href=\"%%T_URL%%#" anc_id "\">" link_txt "</a></li>"
                            }
                            in_block = ""
                        } else if (c_line ~ /^[ \t]*\{\{[ \t]*block\.[a-zA-Z0-9_-]+.*\}\}[ \t]*$/) {
                            nest++
                        } else {
                            if (in_block == "table") {
                                t_buf[++t_len] = $0
                            } else if (nest == 0 && $0 ~ /^[ \t]*::[ \t]*[a-zA-Z0-9_-]+:/) {
                                s = $0
                                sub(/^[ \t]*::[ \t]*/, "", s)
                                idx = index(s, ":")
                                k = substr(s, 1, idx - 1)
                                v = substr(s, idx + 1)
                                sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
                                if (k == id_key) block_id = v
                                if (k == ctx_key) b_context = v
                                if (k == "context") b_context = v
                                if (k == ent_key) b_entity = v
                                if (k == entry_key) b_entity = v
                                if (first_key == "" && k != id_key && k != ctx_key && k != "context" && k != entry_key && k != ent_key) {
                                    first_key = k; first_val = v
                                }
                            }
                        }
                    }
                }
            ' "${filtered_files[@]}")
            for t_f in "${filtered_files[@]}"; do
                local f_html="${file_html_map[$t_f]:-}"
                if [[ -n "$f_html" ]]; then
                    if (( flat_list == 1 )); then
                        list_html+="${f_html}"
                    else
                        local display_path="${file_disp_path[$t_f]}"
                        list_html+="    <li class=\"list-block-${singular}-file\">${display_path}"$'\n'
                        list_html+="        <ul class=\"list-block-${singular}-ul\">"$'\n'
                        list_html+="${f_html}"
                        list_html+="        </ul>"$'\n'
                        list_html+="    </li>"$'\n'
                    fi
                fi
            done
        fi
        if (( flat_list == 1 )); then
            list_html+="</ul>"$'\n'
        else
            list_html+="</ol>"$'\n'
        fi
        list_html+="</list>"
        REPLY="$list_html"
        return 0
    }
    

    __listing_blocks() {
        __listing_blocks_r "$@"
        printf "%s" "$REPLY"
    }
    

}
