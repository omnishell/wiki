#! /bin/bash

__helper__() {
    declare -ga WIKIS WIKI_TEMPLATES 2>/dev/null || true
    declare -gA WIKI_VARS WIKI_PAGES WIKI_PAGE_VARS WIKI_TEMPLATE_VARS WIKI_TOPICS WIKI_REFS WIKI_BLOCKS WIKI_AUTHORS 2>/dev/null || true
    
    __slugify() {
        __slugify_r "$1"
        echo "$REPLY"
    }

    __slugify_r() {
        local s="${1,,}"
        s="${s// /-}"
        if [[ "$s" == *[![:ascii:]]* ]]; then
            s="${s//$'\xC3\xA1'/a}"; s="${s//$'\xC3\xA0'/a}"; s="${s//$'\xC3\xA3'/a}"; s="${s//$'\xC3\xA2'/a}"; s="${s//$'\xC3\xA4'/a}"
            s="${s//$'\xC3\xA9'/e}"; s="${s//$'\xC3\xA8'/e}"; s="${s//$'\xC3\xAA'/e}"; s="${s//$'\xC3\xAB'/e}"
            s="${s//$'\xC3\xAD'/i}"; s="${s//$'\xC3\xAC'/i}"; s="${s//$'\xC3\xAE'/i}"; s="${s//$'\xC3\xAF'/i}"
            s="${s//$'\xC3\xB3'/o}"; s="${s//$'\xC3\xB2'/o}"; s="${s//$'\xC3\xB5'/o}"; s="${s//$'\xC3\xB4'/o}"; s="${s//$'\xC3\xB6'/o}"
            s="${s//$'\xC3\xBA'/u}"; s="${s//$'\xC3\xB9'/u}"; s="${s//$'\xC3\xBB'/u}"; s="${s//$'\xC3\xBC'/u}"
            s="${s//$'\xC3\xA7'/c}"; s="${s//$'\xC3\xB1'/n}"
        fi
        s="${s//[^a-z0-9_./-]/}"
        [[ "$s" == -* && -z "${s//[-neE]/}" ]] && s=""
        REPLY="$s"
    }

    __char_len() {
        local s="${1//[$'\x80'-$'\xbf']/}"
        REPLY=${#s}
    }

    __json_escape_r() {
        local s="$1"
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\r'/}"
        s="${s//$'\t'/\\t}"
        REPLY="$s"
    }

    __json_escape() {
        __json_escape_r "$1"
        printf "%s" "$REPLY"
    }

    __serialize_assoc_r() {
        local -n arr="$1"
        if (( ${#arr[@]} == 0 )); then
            REPLY="declare -A ${1}=()"
            return 0
        fi
        local kv
        kv="$(builtin declare -p "$1" 2>/dev/null)"
        REPLY="declare -A ${1}=${kv#*=}"
    }   

    __serialize_assoc() {
        __serialize_assoc_r "$1"
        printf "%s\n" "$REPLY"
    }

    __save() {
        local rcfile="${OMNIRC:-$HOME/.omnirc}"
        local -a out_lines=()
        declare -p WIKIS >/dev/null 2>&1 || declare -g -a WIKIS=()
        declare -p WIKI_VARS >/dev/null 2>&1 || declare -g -A WIKI_VARS=()
        declare -p WIKI_PAGES >/dev/null 2>&1 || declare -g -A WIKI_PAGES=()
        declare -p WIKI_PAGE_VARS >/dev/null 2>&1 || declare -g -A WIKI_PAGE_VARS=()
        declare -p WIKI_TEMPLATES >/dev/null 2>&1 || declare -g -a WIKI_TEMPLATES=()
        declare -p WIKI_TEMPLATE_VARS >/dev/null 2>&1 || declare -g -A WIKI_TEMPLATE_VARS=()
        declare -p WIKI_TOPICS >/dev/null 2>&1 || declare -g -A WIKI_TOPICS=()
        declare -p WIKI_REFS >/dev/null 2>&1 || declare -g -A WIKI_REFS=()
        declare -p WIKI_BLOCKS >/dev/null 2>&1 || declare -g -A WIKI_BLOCKS=()
        declare -p WIKI_AUTHORS >/dev/null 2>&1 || declare -g -A WIKI_AUTHORS=()

        if [[ -f "$rcfile" ]]; then
            local -a rc_lines=()
            mapfile -t rc_lines < "$rcfile"
            local line
            for line in "${rc_lines[@]}"; do
                case "$line" in
                    "declare -a WIKIS="*|"declare -A WIKI_VARS="*|"declare -A WIKI_PAGES="*|"declare -A WIKI_PAGE_VARS="*|"declare -a WIKI_TEMPLATES="*|"declare -A WIKI_TEMPLATE_VARS="*|"declare -A WIKI_TOPICS="*|"declare -A WIKI_REFS="*|"declare -A WIKI_BLOCKS="*|"declare -A WIKI_AUTHORS="*)
                        continue
                        ;;
                esac
                out_lines+=("$line")
            done
        fi

        local wikis_str="" w
        for w in "${WIKIS[@]}"; do wikis_str+="\"$w\" "; done
        out_lines+=("declare -a WIKIS=($wikis_str)")
        __serialize_assoc_r WIKI_VARS; out_lines+=("$REPLY")
        __serialize_assoc_r WIKI_PAGES; out_lines+=("$REPLY")
        __serialize_assoc_r WIKI_PAGE_VARS; out_lines+=("$REPLY")
        local tmpls_str="" t
        for t in "${WIKI_TEMPLATES[@]}"; do tmpls_str+="\"$t\" "; done
        out_lines+=("declare -a WIKI_TEMPLATES=($tmpls_str)")
        __serialize_assoc_r WIKI_TEMPLATE_VARS; out_lines+=("$REPLY")
        __serialize_assoc_r WIKI_TOPICS; out_lines+=("$REPLY")
        __serialize_assoc_r WIKI_REFS; out_lines+=("$REPLY")
        __serialize_assoc_r WIKI_BLOCKS; out_lines+=("$REPLY")
        __serialize_assoc_r WIKI_AUTHORS; out_lines+=("$REPLY")

        local old_ifs="$IFS"
        IFS=$'\n'
        printf "%s\n" "${out_lines[*]}" > "$rcfile"
        IFS="$old_ifs"
    }

   
    __sort_page_hierarchy() {
        local -n _in_arr="$1"
        local -n _out_arr="$2"
        local delim="${3:-.}"
        local mode="${4:-leaf_first}"
        local leaf_weights_name="${5:-}"
        local root_slug="${6:-}"
        local dir_weights_name="${7:-}"
        _out_arr=()
        local n=${#_in_arr[@]}
        (( n == 0 )) && return 0
        local leaf_type="0" dir_type="1"
        if [[ "$mode" == "dir_first" ]]; then
            leaf_type="1"
            dir_type="0"
        fi
        local -a keys=() items=()
        local item old_ifs="$IFS"
        for item in "${_in_arr[@]}"; do
            IFS="$delim"
            local -a parts=($item)
            IFS="$old_ifs"
            local sort_key="" cum_path="" i
            for (( i=0; i<${#parts[@]}; i++ )); do
                local part="${parts[$i]}"
                if [[ -z "$cum_path" ]]; then
                    cum_path="$part"
                else
                    cum_path="${cum_path}${delim}${part}"
                fi
                local w type
                if (( i == ${#parts[@]} - 1 )); then
                    type="$leaf_type"
                    if [[ -n "$leaf_weights_name" ]]; then
                        local -n _lf_w="$leaf_weights_name"
                        w="${_lf_w[$item]:-9999999}"
                    else
                        w="${PAGE_WEIGHTS[$cum_path]:-9999999}"
                    fi
                else
                    type="$dir_type"
                    local dir_slug_key=""
                    if [[ "$delim" == "/" ]]; then
                        if [[ -n "$root_slug" ]]; then
                            dir_slug_key="${root_slug}.${cum_path//\//.}"
                        else
                            dir_slug_key="${cum_path//\//.}"
                        fi
                        dir_slug_key="${dir_slug_key#.}"
                    else
                        dir_slug_key="$cum_path"
                    fi
                    w="${PAGE_WEIGHTS[$dir_slug_key]:-9999999}"
                    if [[ "$w" == "9999999" && -n "$dir_weights_name" ]]; then
                        local -n _dr_w="$dir_weights_name"
                        w="${_dr_w[$dir_slug_key]:-9999999}"
                    fi
                    if [[ "$w" == "9999999" && "$part" =~ ^([0-9]+)(\..+)?$ ]]; then
                        w="${BASH_REMATCH[1]}"
                    fi
                fi
                w="0000000${w}"
                w="${w: -7}"
                sort_key+="/${type}_${w}_${part}"
            done
            keys+=("$sort_key")
            items+=("$item")
        done

        if (( n > 1 )); then
            local -a stack_l=(0) stack_r=($((n - 1)))
            local sp=0 low high i j pivot_k tmp_k tmp_v
            while (( sp >= 0 )); do
                low=${stack_l[sp]}
                high=${stack_r[sp]}
                (( sp-- ))
                if (( high - low <= 12 )); then
                    for (( i = low + 1; i <= high; i++ )); do
                        tmp_k="${keys[i]}"
                        tmp_v="${items[i]}"
                        j=$(( i - 1 ))
                        while (( j >= low )) && [[ "${keys[j]}" > "$tmp_k" ]]; do
                            keys[j+1]="${keys[j]}"
                            items[j+1]="${items[j]}"
                            (( j-- ))
                        done
                        keys[j+1]="$tmp_k"
                        items[j+1]="$tmp_v"
                    done
                else
                    pivot_k="${keys[(low + high) / 2]}"
                    i=$low
                    j=$high
                    while (( i <= j )); do
                        while [[ "${keys[i]}" < "$pivot_k" ]]; do (( i++ )); done
                        while [[ "${keys[j]}" > "$pivot_k" ]]; do (( j-- )); done
                        if (( i <= j )); then
                            tmp_k="${keys[i]}"; keys[i]="${keys[j]}"; keys[j]="$tmp_k"
                            tmp_v="${items[i]}"; items[i]="${items[j]}"; items[j]="$tmp_v"
                            (( i++ ))
                            (( j-- ))
                        fi
                    done
                    if (( low < j )); then
                        (( sp++ )); stack_l[sp]=$low; stack_r[sp]=$j
                    fi
                    if (( i < high )); then
                        (( sp++ )); stack_l[sp]=$i; stack_r[sp]=$high
                    fi
                fi
            done
        fi
        _out_arr=("${items[@]}")
    }

    __read_page_source() {
        local file="$1"
        local vars_map_name="$2"
        local body_lines_name="${3:-}"
        local block_types_name="${4:-}"
        local block_title_keys_name="${5:-}"
        [[ -f "$file" ]] || return 1
        local -n _vars="$vars_map_name"
        local -a all_lines=()
        mapfile -t all_lines < "$file"
        local in_fm=0 fm_checked=0 in_globals=0 in_block=""
        local line trimmed l_trim
        for line in "${all_lines[@]}"; do
            trimmed="${line%$'\r'}"
            l_trim="${trimmed#"${trimmed%%[![:space:]]*}"}"
            if (( fm_checked == 0 )); then
                if [[ "$trimmed" == "---"* && -z "${trimmed#---}" ]]; then
                    in_fm=1
                    fm_checked=1
                    continue
                fi
                fm_checked=1
            fi
            if (( in_fm == 1 )); then
                if [[ "$trimmed" == "---"* && -z "${trimmed#---}" ]]; then
                    in_fm=0
                    continue
                fi
                if [[ "$l_trim" == *:* ]]; then
                    local k="${l_trim%%:*}"
                    if [[ -n "$k" && -z "${k//[a-zA-Z0-9_.-]/}" ]]; then
                        local v="${l_trim#*:}"
                        v="${v#"${v%%[![:space:]]*}"}"
                        v="${v%"${v##*[![:space:]]}"}"
                        v="${v#\"}"; v="${v%\"}"
                        v="${v#\'}"; v="${v%\'}"
                        _vars["$k"]="$v"
                        _vars["page.$k"]="$v"
                        [[ "$k" == "weighted" ]] && { _vars["weight"]="$v"; _vars["page.weight"]="$v"; }
                    fi
                fi
                continue
            fi
            if [[ "$l_trim" == "{{"*"block."* && "$l_trim" == *"}}"* ]]; then
                local r_trim="${l_trim%"${l_trim##*[![:space:]]}"}"
                if [[ "$r_trim" == "{{"*"}}" ]]; then
                    local inner="${r_trim#\{\{}"
                    inner="${inner%\}\}}"
                    inner="${inner#"${inner%%[![:space:]]*}"}"
                    inner="${inner%"${inner##*[![:space:]]}"}"
                    if [[ "$inner" == "block.end" ]]; then
                        in_globals=0
                        in_block=""
                        continue
                    elif [[ "$inner" == "block."* ]]; then
                        local bname="${inner#block.}"
                        if [[ -n "$bname" && -z "${bname//[a-zA-Z0-9_-]/}" ]]; then
                            if [[ "$bname" == "globals" ]]; then
                                in_globals=1
                            else
                                in_block="$bname"
                                if [[ -n "$block_types_name" ]]; then
                                    local -n _btypes="$block_types_name"
                                    _btypes["$bname"]=1
                                fi
                                if [[ "$bname" == "table" && -n "$block_title_keys_name" ]]; then
                                    local -n _bkeys="$block_title_keys_name"
                                    _bkeys["table"]="caption"
                                fi
                            fi
                            continue
                        fi
                    fi
                fi
            fi
            if (( in_globals == 1 )); then
                if [[ "$l_trim" == "::"* ]]; then
                    local after_col="${l_trim#::}"
                    after_col="${after_col#"${after_col%%[![:space:]]*}"}"
                    if [[ "$after_col" == *:* ]]; then
                        local k="${after_col%%:*}"
                        if [[ -n "$k" && -z "${k//[a-zA-Z0-9_.-]/}" ]]; then
                            local v="${after_col#*:}"
                            v="${v#"${v%%[![:space:]]*}"}"
                            v="${v%"${v##*[![:space:]]}"}"
                            v="${v#\"}"; v="${v%\"}"
                            v="${v#\'}"; v="${v%\'}"
                            _vars["$k"]="$v"
                            _vars["page.$k"]="$v"
                            [[ "$k" == "weighted" ]] && { _vars["weight"]="$v"; _vars["page.weight"]="$v"; }
                        fi
                    fi
                fi
                continue
            fi
            if [[ -n "$in_block" && -n "$block_title_keys_name" ]]; then
                if [[ "$l_trim" == "::"* ]]; then
                    local after_col="${l_trim#::}"
                    after_col="${after_col#"${after_col%%[![:space:]]*}"}"
                    if [[ "$after_col" == *:* ]]; then
                        local k="${after_col%%:*}"
                        if [[ -n "$k" && -z "${k//[a-zA-Z0-9_.-]/}" ]]; then
                            local -n _bkeys="$block_title_keys_name"
                            if [[ -z "${_bkeys["$in_block"]:-}" && "$k" != "__id__" && "$k" != "__context__" && "$k" != "__entry__" ]]; then
                                _bkeys["$in_block"]="$k"
                            fi
                        fi
                    fi
                fi
            fi
            if [[ -n "$body_lines_name" ]]; then
                local -n _body="$body_lines_name"
                _body+=("$line")
            fi
        done
        if [[ -n "$block_types_name" ]]; then
            local -n _btypes="$block_types_name"
            _btypes["page"]=1
            local ft="${_vars["page.tags"]:-${_vars["tags"]:-}}"
            [[ -n "$ft" ]] && _btypes["tag"]=1
        fi
        return 0
    }

    __search_index() {
        local plain_content=""
        set -f
        local old_ifs="$IFS"
        IFS='<'
        local -a html_parts=($content)
        IFS=""
        if (( ${#html_parts[@]} > 1 )); then
            local head="${html_parts[0]}"
            local -a rest=("${html_parts[@]:1}")
            plain_content="${head}${rest[*]#*>}"
        else
            plain_content="$content"
        fi
        IFS="$old_ifs"
        set +f
        __json_escape_r "$plain_content"
        local enc_content="$REPLY"
        __json_escape_r "/${pagename//./\/}.html"; local enc_url="$REPLY"
        __json_escape_r "$pagename"; local enc_pagename="$REPLY"
        __json_escape_r "$current_dir"; local enc_category="$REPLY"
        local file_tags="${PAGE_VARS["page.tags"]:-${PAGE_TAGS["$pagename"]:-${PAGE_VARS["tags"]:-}}}"
        __json_escape_r "$file_tags"; local enc_tags="$REPLY"
        SEARCH_INDEX_MAP["page"]+="{\"url\":\"$enc_url\",\"pagename\":\"$enc_pagename\",\"category\":\"$enc_category\",\"content\":\"$enc_content\",\"globals.tags\":\"$enc_tags\"},"$'\n'
        if [[ -n "$file_tags" ]]; then
            set -f
            IFS=", "
            local -a tag_arr=($file_tags)
            IFS="$old_ifs"
            set +f
            local t enc_t
            for t in "${tag_arr[@]}"; do
                [[ -z "$t" ]] && continue
                __json_escape_r "$t"; enc_t="$REPLY"
                SEARCH_INDEX_MAP["tag"]+="{\"url\":\"$enc_url\",\"tag\":\"$enc_t\",\"pagename\":\"$enc_pagename\"},"$'\n'
            done
        fi
    }    
}
