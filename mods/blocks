#! /bin/bash

__blocks__() {
    
    __block_core() {
        local bname="$1"
        local -n buffer_ref="$2"
        local -a BLOCK_KEYS=()
        local -A BLOCK_VALS=()
        local current_key="" current_val="" b_line l_trim r_trim inner after_col k_part v_part
        local nested_depth=0
        for b_line in "${buffer_ref[@]}"; do
            l_trim="${b_line#"${b_line%%[![:space:]]*}"}"
            if [[ "$l_trim" == "::"* ]]; then
                after_col="${l_trim#::}"
                if [[ "$after_col" == [[:blank:]]* ]]; then
                    after_col="${after_col:1}"
                fi
                local sub_trim="${after_col#"${after_col%%[![:space:]]*}"}"
                if [[ "$sub_trim" == "{{"*"}}"* ]]; then
                    l_trim="$sub_trim"
                fi
            fi
            if [[ "$l_trim" == "{{"*"}}"* ]]; then
                r_trim="${l_trim%"${l_trim##*[![:space:]]}"}"
                if [[ "$r_trim" == "{{"*"}}" ]]; then
                    inner="${r_trim#\{\{}"
                    inner="${inner%\}\}}"
                    inner="${inner#"${inner%%[![:space:]]*}"}"
                    inner="${inner%"${inner##*[![:space:]]}"}"
                    if [[ "$inner" == "block.end" ]]; then
                        (( nested_depth > 0 )) && (( nested_depth-- ))
                    elif [[ "$inner" == block.* ]]; then
                        (( nested_depth++ ))
                    fi
                fi
            fi
            if (( nested_depth == 0 )) && [[ "$l_trim" == "::"* ]]; then
                after_col="${l_trim#::}"
                after_col="${after_col#"${after_col%%[![:space:]]*}"}"
                if [[ "$after_col" == *:* ]]; then
                    k_part="${after_col%%:*}"
                    if [[ -n "$k_part" && -z "${k_part//[a-zA-Z0-9_-]/}" ]]; then
                        if [[ -n "$current_key" ]]; then
                            BLOCK_VALS["$current_key"]="$current_val"
                            BLOCK_KEYS+=("$current_key")
                        fi
                        current_key="$k_part"
                        v_part="${after_col#*:}"
                        v_part="${v_part#"${v_part%%[![:space:]]*}"}"
                        v_part="${v_part%"${v_part##*[![:space:]]}"}"
                        current_val="$v_part"
                        continue
                    fi
                fi
            fi
            if [[ -n "$current_key" ]]; then
                current_val+=$'\n'"$b_line"
            fi
        done
        if [[ -n "$current_key" ]]; then
            BLOCK_VALS["$current_key"]="$current_val"
            BLOCK_KEYS+=("$current_key")
        fi
        local -A BLOCK_DISPLAY_KEYS=()
        local -A BLOCK_DISPLAY_VALS=()
        local k
        for k in "${BLOCK_KEYS[@]}"; do
            BLOCK_DISPLAY_KEYS["$k"]="$k"
            BLOCK_DISPLAY_VALS["$k"]="${BLOCK_VALS[$k]}"
        done
        local SKIP_DEFAULT_REFS=0
        if [[ "$bname" == "def" ]]; then
            __block_def_hook
        elif declare -F "__block_${bname}_hook" >/dev/null; then
            "__block_${bname}_hook"
        fi
        local block_entry="${BLOCK_VALS[__entry__]:-}"
        local block_context="${BLOCK_VALS[__context__]:-}"
        local first_content_key="" first_content_val=""
        if [[ -n "${BLOCK_VALS[term]:-}" ]]; then
            first_content_key="term"
            first_content_val="${BLOCK_VALS[term]}"
        elif [[ -n "${BLOCK_VALS[type]:-}" ]]; then
            first_content_key="type"
            first_content_val="${BLOCK_VALS[type]}"
        else
            for k in "${BLOCK_KEYS[@]}"; do
                if [[ "$k" != "__id__" && "$k" != "__context__" && "$k" != "context" && "$k" != "__entry__" && "$k" != "__refs__" ]]; then
                    first_content_key="$k"
                    first_content_val="${BLOCK_VALS[$k]}"
                    break
                fi
            done
        fi
        local raw_id="${BLOCK_VALS[__id__]:-}"
        if [[ -z "$raw_id" ]]; then
            raw_id="${block_entry:-${first_content_val}}"
        fi
        if [[ -z "$raw_id" && ${#BLOCK_KEYS[@]} -gt 0 ]]; then
            raw_id="${BLOCK_VALS[${BLOCK_KEYS[0]}]}"
        fi
        local clean_id=""
        __slugify_r "$raw_id"
        clean_id="$REPLY"
        [[ -z "$clean_id" ]] && clean_id="rnd-$RANDOM"
        local ref_key="$clean_id"
        if [[ -n "$block_context" && "$raw_id" != *.* ]]; then
            __slugify_r "${block_context}.${raw_id}"
            ref_key="$REPLY"
        fi
        local anchor_id_slug="${ref_key//[\/.]/-}"
        local anchor_id="block-${bname}-${anchor_id_slug}"
        local BLOCK_ID="$clean_id"
        local BLOCK_TITLE="${block_entry:-${first_content_val:-$raw_id}}"
        if (( SKIP_DEFAULT_REFS == 0 )) && [[ -n "$w_name" ]]; then
            WIKI_REFS["${bname}::${ref_key}"]="${pagename}:${anchor_id}"
            WIKI_REFS["${w_name}::${ENV:-}::${bname}::${ref_key}"]="${pagename}:${anchor_id}"
        fi
        if [[ -n "${BLOCK_VALS[__context__]:-}" ]]; then
            local first_dk=""
            for k in "${BLOCK_KEYS[@]}"; do
                if [[ -n "${BLOCK_DISPLAY_KEYS[$k]:-}" && "$k" != "__id__" && "$k" != "__context__" && "$k" != "__entry__" && "$k" != "__refs__" ]]; then
                    first_dk="$k"
                    break
                fi
            done
            if [[ -n "$first_dk" ]]; then
                BLOCK_DISPLAY_VALS["$first_dk"]+=" <span class=\"def-context\">(${BLOCK_VALS[__context__]})</span>"
            fi
        fi
        local -a html_parts=(
            "<block id=\"${anchor_id}\" class=\"block-${bname}\">"
            "    <fields id=\"fields-${bname}-${anchor_id_slug}\" class=\"fields-${bname}\">"
        )
        __json_escape_r "/${pagename//./\/}.html#${anchor_id}"
        local -a json_parts=("{\"url\":\"$REPLY\"")
        if [[ -n "${BLOCK_VALS[__context__]:-}" ]]; then
            __json_escape_r "${BLOCK_VALS[__context__]}"
            json_parts+=(",\"__context__\":\"$REPLY\"")
        fi
        for k in "${BLOCK_KEYS[@]}"; do
            [[ "$k" == "__id__" || "$k" == "__context__" || "$k" == "__entry__" ]] && continue
            local v="${BLOCK_VALS[$k]}"
            __json_escape_r "$v"
            json_parts+=(",\"${k}\":\"$REPLY\"")
            local dk="${BLOCK_DISPLAY_KEYS[$k]:-}"
            [[ -z "$dk" ]] && continue
            local dv="${BLOCK_DISPLAY_VALS[$k]}"
            if [[ "$k" == "__refs__" || "$dk" == "__refs__" ]]; then
                local prefix_name="refs"
                [[ "$k" != "__refs__" ]] && prefix_name="$k"
                local -a rel_parts=("<ul>")
                set -f
                local OIFS="$IFS"; IFS=','
                local -a r_items=($dv)
                IFS="$OIFS"
                set +f
                local r_item r_topic r_ref slug_ref
                for r_item in "${r_items[@]}"; do
                    r_item="${r_item#"${r_item%%[![:space:]]*}"}"; r_item="${r_item%"${r_item##*[![:space:]]}"}"
                    if [[ -n "$r_item" ]]; then
                        r_topic="${r_item%%.*}"
                        r_ref="${r_item#*.}"
                        __slugify_r "$r_ref"
                        slug_ref="$REPLY"
                        if [[ "$r_topic" == "page" ]]; then
                            rel_parts+=("        <li><a href=\"/${slug_ref//./\/}.html\">${r_ref}</a></li>")
                        else
                            rel_parts+=("        <li>%%WIKI_REF:${r_topic}:${slug_ref}:${r_ref}%%</li>")
                        fi
                    fi
                done
                rel_parts+=("    </ul>")
                local OIFS="$IFS"; IFS=$'\n'; dv="${rel_parts[*]}"; IFS="$OIFS"
                dk="$prefix_name"
            elif [[ "${BLOCK_VALS[$k]}" == "$dv" ]]; then
                __parse_block_field_r "$dv"; dv="$REPLY"
            fi
            html_parts+=(
                "        <field id=\"field-${bname}-${dk}-${anchor_id_slug}\" class=\"field-${bname}-${dk}\">"
                "            <prefix id=\"prefix-${bname}-${dk}-${anchor_id_slug}\" class=\"prefix-${bname}-${dk}\">${dk}: </prefix><div id=\"text-${bname}-${dk}-${anchor_id_slug}\" class=\"text-prefix-${bname}-${dk}\">${dv}</div>"
                "        </field>"
            )
        done
        html_parts+=("    </fields>" "</block>")
        json_parts+=("},"$'\n')
        local old_ifs="$IFS"
        IFS=""
        SEARCH_INDEX_MAP["$bname"]+="${json_parts[*]}"
        IFS=$'\n'
        content+="${html_parts[*]}"$'\n'
        IFS="$old_ifs"
        if [[ -z "${PAGE_TITLE_KEYS[$bname]:-}" ]]; then
            PAGE_TITLE_KEYS["$bname"]="${first_content_key:-${BLOCK_KEYS[0]}}"
        fi
        LIST_HTML_MAP["$bname"]+="<li><a href=\"#${anchor_id}\">${BLOCK_TITLE}</a></li>"$'\n'
    }

    
    __block_quote() {
        local bname="$1"
        local -n my_buffer="$2"
        if (( ${#my_buffer[@]} == 0 )); then return; fi

        local b_id="rnd-$RANDOM"
        local b_width="" b_style="" q_cite=""
        local q_text="" current_key="" current_val="" b_line l_trim after_col k_part v_part

        for b_line in "${my_buffer[@]}"; do
            l_trim="${b_line#"${b_line%%[![:space:]]*}"}"
            if [[ "$l_trim" == "::"* ]]; then
                after_col="${l_trim#::}"
                after_col="${after_col#"${after_col%%[![:space:]]*}"}"
                if [[ "$after_col" == *:* ]]; then
                    k_part="${after_col%%:*}"
                    if [[ -n "$k_part" && -z "${k_part//[a-zA-Z0-9_-]/}" ]]; then
                        if [[ -n "$current_key" ]]; then
                            case "$current_key" in
                                __id__) b_id="$current_val" ;;
                                __width__) b_width="$current_val" ;;
                                __style__) b_style="$current_val" ;;
                                cite) q_cite="$current_val" ;;
                                text) q_text="${q_text:+$q_text$'\n'}$current_val" ;;
                            esac
                        fi
                        current_key="$k_part"
                        v_part="${after_col#*:}"
                        v_part="${v_part#"${v_part%%[![:space:]]*}"}"
                        v_part="${v_part%"${v_part##*[![:space:]]}"}"
                        current_val="$v_part"
                        continue
                    fi
                fi
            fi
            if [[ -n "$current_key" ]]; then
                current_val+=$'\n'"$b_line"
            else
                q_text+="${q_text:+$'\n'}$b_line"
            fi
        done

        if [[ -n "$current_key" ]]; then
            case "$current_key" in
                __id__) b_id="$current_val" ;;
                __width__) b_width="$current_val" ;;
                __style__) b_style="$current_val" ;;
                cite) q_cite="$current_val" ;;
                text) q_text="${q_text:+$q_text$'\n'}$current_val" ;;
            esac
        fi

        q_text="${q_text#"${q_text%%[![:space:]]*}"}"
        q_text="${q_text%"${q_text##*[![:space:]]}"}"

        __parse_block_field_r "$q_text"; q_text="$REPLY"
        __get_style_attr_r "$b_width" "$b_style"
        local style_attr="$REPLY"
        local cite_attr=""
        [[ -n "$q_cite" ]] && cite_attr=" cite=\"${q_cite}\""

        content+="<blockquote id=\"block-quote-${b_id}\" class=\"block-quote\"${style_attr}${cite_attr}>"$'\n'"    ${q_text}"$'\n'"</blockquote>"$'\n'
    }    

    __block_def_hook() {
        if [[ -n "${BLOCK_DISPLAY_KEYS[term]:-}" ]]; then
            BLOCK_DISPLAY_KEYS["term"]="def"
            BLOCK_DISPLAY_VALS["term"]="<u>${BLOCK_VALS[term]}</u>"
        fi
        if [[ -n "${BLOCK_VALS[context]:-}" ]]; then
            BLOCK_VALS["__context__"]="${BLOCK_VALS[context]}"
            BLOCK_DISPLAY_KEYS["context"]=""
        fi
        local def_ctx="${BLOCK_VALS[__context__]:-}"
        local self_raw="${BLOCK_VALS[__id__]:-${BLOCK_VALS[__entry__]:-${BLOCK_VALS[term]:-}}}"
        local self_slug=""
        if [[ -n "$self_raw" ]]; then
            if [[ -n "$def_ctx" && "$self_raw" != *.* ]]; then
                __slugify_r "${def_ctx}.${self_raw}"
            else
                __slugify_r "$self_raw"
            fi
            self_slug="$REPLY"
        fi
        if [[ -z "${BLOCK_VALS[related]:-}" && -z "${BLOCK_VALS[__refs__]:-}" ]]; then
            local text_to_scan="${BLOCK_VALS[idea]:-}"$'\n'"${BLOCK_VALS[details]:-}"
            if [[ "$text_to_scan" == *"{{"*":"*"}}"* ]]; then
                local extracted_refs=""
                local -A seen_refs=()
                local rem="$text_to_scan" inner t_topic t_rest t_ref full_ref ref_slug
                while [[ "$rem" == *"{{"*"}}"* ]]; do
                    rem="${rem#*\{\{}"
                    inner="${rem%%\}\}*}"
                    rem="${rem#*\}\}}"
                    if [[ "$inner" == *:* ]]; then
                        inner="${inner#"${inner%%[![:space:]]*}"}"
                        inner="${inner%"${inner##*[![:space:]]}"}"
                        t_topic="${inner%%:*}"
                        if [[ -n "$t_topic" && -z "${t_topic//[a-zA-Z0-9_-]/}" && "$t_topic" != "page" && "$t_topic" != "block" ]]; then
                            t_rest="${inner#*:}"
                            t_ref="${t_rest%%:*}"
                            t_ref="${t_ref#"${t_ref%%[![:space:]]*}"}"
                            t_ref="${t_ref%"${t_ref##*[![:space:]]}"}"
                            if [[ -n "$t_ref" ]]; then
                                if [[ "$t_topic" == "def" && -n "$def_ctx" && "$t_ref" != *.* ]]; then
                                    t_ref="${def_ctx}.${t_ref}"
                                fi
                                __slugify_r "$t_ref"
                                ref_slug="$REPLY"
                                [[ "$t_topic" == "def" && -n "$self_slug" && "$ref_slug" == "$self_slug" ]] && continue
                                full_ref="${t_topic}.${t_ref}"
                                if [[ -z "${seen_refs[$full_ref]:-}" ]]; then
                                    seen_refs["$full_ref"]=1
                                    extracted_refs+="${extracted_refs:+, }${full_ref}"
                                fi
                            fi
                        fi
                    fi
                done
                if [[ -n "$extracted_refs" ]]; then
                    BLOCK_VALS["related"]="$extracted_refs"
                    if [[ -z "${BLOCK_DISPLAY_KEYS[related]:-}" ]]; then
                        BLOCK_KEYS+=("related")
                    fi
                    BLOCK_DISPLAY_KEYS["related"]="related"
                    BLOCK_DISPLAY_VALS["related"]="$extracted_refs"
                fi
            fi
        fi
        if [[ -n "${BLOCK_VALS[related]:-}" ]]; then
            local new_rel=""
            set -f
            local OIFS="$IFS"; IFS=','
            local -a r_items=(${BLOCK_VALS[related]})
            IFS="$OIFS"
            set +f
            local r_item
            for r_item in "${r_items[@]}"; do
                r_item="${r_item#"${r_item%%[![:space:]]*}"}"; r_item="${r_item%"${r_item##*[![:space:]]}"}"
                if [[ -n "$r_item" ]]; then
                    if [[ "$r_item" != *.*.* && "$r_item" != def.* ]]; then
                        new_rel+="${new_rel:+, }def.${r_item}"
                    else
                        new_rel+="${new_rel:+, }${r_item}"
                    fi
                fi
            done
            BLOCK_DISPLAY_VALS["related"]="$new_rel"
            BLOCK_DISPLAY_KEYS["related"]="__refs__"
        fi
    }
    

    __block_def() {
        __block_core "$1" "$2"
    }    

    __block_table() {
        if [[ ${#table_buffer[@]} -lt 3 ]]; then return; fi
        local sep_indices=() i tmp clean_tmp
        for (( i=0; i<${#table_buffer[@]}; i++ )); do
            tmp="${table_buffer[$i]}"
            tmp="${tmp//$'\t'/    }"
            tmp="${tmp//[[:cntrl:]]/}"
            tmp="${tmp//$'\xC2\xA0'/ }"
            tmp="${tmp//$'\xA0'/ }"
            table_buffer[$i]="$tmp"
            clean_tmp="${tmp// /}"
            if [[ -n "$clean_tmp" && -z "${clean_tmp//[-=_]/}" ]]; then
                sep_indices+=($i)
            fi
        done
        if [[ ${#sep_indices[@]} -lt 1 ]]; then return; fi
        local sep1=${sep_indices[0]} sep2=${#table_buffer[@]} caption_line=""
        if [[ ${#sep_indices[@]} -ge 2 ]]; then
            sep2=${sep_indices[${#sep_indices[@]}-1]}
            for (( i=sep2+1; i<${#table_buffer[@]}; i++ )); do
                local cl="${table_buffer[$i]}"
                cl="${cl#"${cl%%[! ]*}"}"; cl="${cl%"${cl##*[! ]}"}"
                if [[ -n "$cl" ]]; then caption_line="$cl"; break; fi
            done
        fi
        local header_line="${table_buffer[0]}"
        header_line="${header_line#"${header_line%%[! ]*}"}"
        header_line="${header_line%"${header_line##*[! ]}"}"
        local sep=$'\x1F'
        local h_tmp="${header_line//  /$sep}"
        while [[ "$h_tmp" == *$sep' '* ]]; do h_tmp="${h_tmp//$sep' '/$sep}"; done
        while [[ "$h_tmp" == *' '$sep* ]]; do h_tmp="${h_tmp//' '$sep/$sep}"; done
        while [[ "$h_tmp" == *$sep$sep* ]]; do h_tmp="${h_tmp//$sep$sep/$sep}"; done
        local IFS="$sep"
        local -a headers=()
        read -ra headers <<< "$h_tmp"
        IFS=$' \t\n'
        local num_columns=${#headers[@]}
        if [[ $num_columns -eq 0 ]]; then return; fi
        local -a max_widths=()
        local j
        for (( j=0; j<num_columns; j++ )); do
            __char_len "${headers[$j]}"; max_widths[$j]=$REPLY
        done
        local -a parsed_rows=()
        for (( i=sep1+1; i<sep2; i++ )); do
            local row_str="${table_buffer[$i]}"
            row_str="${row_str#"${row_str%%[! ]*}"}"; row_str="${row_str%"${row_str##*[! ]}"}"
            if [[ -z "$row_str" ]]; then continue; fi
            local r_tmp="${row_str//  /$sep}"
            while [[ "$r_tmp" == *$sep' '* ]]; do r_tmp="${r_tmp//$sep' '/$sep}"; done
            while [[ "$r_tmp" == *' '$sep* ]]; do r_tmp="${r_tmp//' '$sep/$sep}"; done
            while [[ "$r_tmp" == *$sep$sep* ]]; do r_tmp="${r_tmp//$sep$sep/$sep}"; done
            parsed_rows+=("$r_tmp")
            local -a cols=()
            local IFS="$sep"
            read -ra cols <<< "$r_tmp"
            IFS=$' \t\n'
            if [[ ${#cols[@]} -gt num_columns ]]; then
                local last_col="${cols[num_columns-1]}"
                local k
                for (( k=num_columns; k<${#cols[@]}; k++ )); do
                    last_col+=" ${cols[k]}"
                done
                cols[num_columns-1]="$last_col"
            fi
            for (( j=0; j<num_columns; j++ )); do
                __char_len "${cols[$j]}"; local flen=$REPLY
                if (( flen > max_widths[j] )); then
                    max_widths[$j]=$flen
                fi
            done
        done
        ((page_table_count++))
        local table_id="table-${page_table_count}"
        local _dash_pool="--------------------------------------------------------------------------------------------------------------------------------"
        local sep_row_html="<tr class=\"ascii-separator\">"
        for (( j=0; j<num_columns; j++ )); do
            local f_len=$(( max_widths[j] + 4 ))
            while (( ${#_dash_pool} < f_len )); do _dash_pool+="$_dash_pool"; done
            sep_row_html+="<td><p>${_dash_pool:0:f_len}</p></td>"
        done
        sep_row_html+="</tr>"$'\n'

        local table_html="<div id=\"${table_id}\" class=\"captioned-table\">"$'\n'"<table class=\"custom-pre-table\">"$'\n'
        table_html+="<thead>"$'\n'"<tr>"
        local field temp_line
        for (( j=0; j<num_columns; j++ )); do
            field="${headers[$j]}"
            field="${field#"${field%%[! ]*}"}"; field="${field%"${field##*[! ]}"}"
            temp_line="$line"
            line="$field"
            line="${line//&/&amp;}"; line="${line//</&lt;}"; line="${line//>/&gt;}"
            line="${line//_/$'\x1E'}"
            __parse_inline
            line="${line//$'\x1E'/_}"
            field="$line"
            line="$temp_line"
            table_html+="<th><p>${field}</p></th>"
        done
        table_html+="</tr>"$'\n'"</thead>"$'\n'"<tbody>"$'\n'
        table_html+="$sep_row_html"
        local r_tmp
        for r_tmp in "${parsed_rows[@]}"; do
            local -a cols=()
            local IFS="$sep"
            read -ra cols <<< "$r_tmp"
            IFS=$' \t\n'
            if [[ ${#cols[@]} -gt num_columns ]]; then
                local last_col="${cols[num_columns-1]}"
                local k
                for (( k=num_columns; k<${#cols[@]}; k++ )); do
                    last_col+=" ${cols[k]}"
                done
                cols[num_columns-1]="$last_col"
            fi
            table_html+="<tr>"
            for (( j=0; j<num_columns; j++ )); do
                field="${cols[$j]:-}"
                field="${field#"${field%%[! ]*}"}"; field="${field%"${field##*[! ]}"}"
                temp_line="$line"
                line="$field"
                line="${line//&/&amp;}"; line="${line//</&lt;}"; line="${line//>/&gt;}"
                line="${line//_/$'\x1E'}"
                __parse_inline
                line="${line//$'\x1E'/_}"
                field="$line"
                line="$temp_line"
                table_html+="<td><p>${field}</p></td>"
            done
            table_html+="</tr>"$'\n'
        done
        if [[ ${#sep_indices[@]} -ge 2 ]]; then
            table_html+="$sep_row_html"
        fi
        table_html+="</tbody>"$'\n'"</table>"$'\n'
        if [[ -n "$caption_line" ]]; then
            caption_line="${caption_line//&/&amp;}"
            caption_line="${caption_line//</&lt;}"
            caption_line="${caption_line//>/&gt;}"
            table_html+="<p><a href=\"#\" class=\"table-caption\">${caption_line}</a></p>"$'\n'
        fi
        table_html+="</div>"$'\n'
        __json_escape_r "/${pagename//./\/}.html"; local enc_url="$REPLY"
        __json_escape_r "$header_line"; local enc_headers="$REPLY"
        __json_escape_r "${table_buffer[*]}"; local enc_lines="$REPLY"
        SEARCH_INDEX_MAP["table"]+="{\"url\":\"$enc_url\",\"headers\":\"$enc_headers\",\"columns\":\"$num_columns\",\"lines\":\"$enc_lines\"},"$'\n'
        LIST_HTML_MAP["table"]+="<li><a href=\"#${table_id}\">${caption_line:-Table ${page_table_count}}</a></li>"$'\n'
        content+="${table_html}"
    }   

    
    __diagram_strip_quotes_r() {
        local val="$1"
        val="${val#"${val%%[![:space:]]*}"}"
        val="${val%"${val##*[![:space:]]}"}"
        if [[ ("${val:0:1}" == '"' && "${val: -1}" == '"') || ("${val:0:1}" == "'" && "${val: -1}" == "'") ]]; then
            val="${val:1:-1}"
        fi
        REPLY="$val"
    }

    __diagram_split_props() {
        local str="$1"
        local -n _out_arr="$2"
        _out_arr=()
        local cur="" in_q="" char len=${#str} idx=0
        for (( idx=0; idx<len; idx++ )); do
            char="${str:idx:1}"
            if [[ -z "$in_q" ]]; then
                if [[ "$char" == '"' || "$char" == "'" ]]; then
                    in_q="$char"
                    cur+="$char"
                elif [[ "$char" == ',' ]]; then
                    cur="${cur#"${cur%%[![:space:]]*}"}"
                    cur="${cur%"${cur##*[![:space:]]}"}"
                    [[ -n "$cur" ]] && _out_arr+=("$cur")
                    cur=""
                else
                    cur+="$char"
                fi
            else
                if [[ "$char" == "$in_q" ]]; then
                    in_q=""
                fi
                cur+="$char"
            fi
        done
        cur="${cur#"${cur%%[![:space:]]*}"}"
        cur="${cur%"${cur##*[![:space:]]}"}"
        [[ -n "$cur" ]] && _out_arr+=("$cur")
    }

    __diagram_render_tex() {
        declare -gA LATEX_MEM_CACHE 2>/dev/null || true
        local str="$1"
        REPLY_HTML="$str"
        REPLY_W_TEX=0
        REPLY_HAS_TEX=0
        if [[ "$str" == *"$"* ]]; then
            local math_re='^([^$]*)\$([^$]+)\$(.*)$'
            local vb_re='viewBox=[\"\'\'']([0-9.-]+)[[:space:],]+([0-9.-]+)[[:space:],]+([0-9.-]+)[[:space:],]+([0-9.-]+)[\"\'\'']'
            local baseline_re='.*<rect x=[\"\'\''][0-9.-]+[\"\'\''] y=[\"\'\'']([0-9.-]+)[\"\'\''] width=[\"\'\'']0[\"\'\'']'
            local out=""
            local work="$str"
            while [[ "$work" =~ $math_re ]]; do
                REPLY_HAS_TEX=1
                local prefix="${BASH_REMATCH[1]}"
                local math_code="${BASH_REMATCH[2]}"
                local suffix="${BASH_REMATCH[3]}"
                local cached_span="${LATEX_MEM_CACHE["inline:${math_code}"]:-}"
                local pt_w=20
                if [[ -z "$cached_span" ]]; then
                    local svg_output
                    svg_output=$("$_WIKI_DIR/bin/latex" --stdout --inline --dpr 0.4 <<< "${math_code}\\rule{0pt}{0pt}" 2>/dev/null || true)
                    if [[ -n "$svg_output" ]]; then
                        svg_output="${svg_output//rgba(0,0,0,1)/var(--fg)}"
                        local min_y=0 height=0
                        if [[ "$svg_output" =~ $vb_re ]]; then
                            min_y="${BASH_REMATCH[2]}"
                            height="${BASH_REMATCH[4]}"
                            local w_val="${BASH_REMATCH[3]}"
                            pt_w="${w_val%.*}"
                        fi
                        local align="-10px"
                        [[ "$svg_output" =~ $baseline_re ]] && align="${BASH_REMATCH[1]}pt - (${min_y}pt + ${height}pt) - 1px"
                        cached_span="<span class=\"latex-inline\" style=\"vertical-align: calc(${align});\">${svg_output}</span>"
                        LATEX_MEM_CACHE["inline:${math_code}"]="$cached_span"
                    else
                        cached_span="\$${math_code}\$"
                    fi
                else
                    if [[ "$cached_span" =~ $vb_re ]]; then
                        local w_val="${BASH_REMATCH[3]}"
                        pt_w="${w_val%.*}"
                    fi
                fi
                (( REPLY_W_TEX += pt_w ))
                out+="${prefix}${cached_span}"
                work="$suffix"
            done
            out+="$work"
            REPLY_HTML="$out"
        fi
    }   
   
    __block_diagram() {
        if (( ${#diagram_buffer[@]} == 0 )); then return; fi
        local -a node_lines=() arrow_lines=()
        local diagram_caption=""
        local line old_ifs="$IFS"

        for line in "${diagram_buffer[@]}"; do
            if [[ "$line" =~ ^[[:space:]]*::[[:space:]]*caption[[:space:]]*:[[:space:]]*(.*)$ ]]; then
                __diagram_strip_quotes_r "${BASH_REMATCH[1]}"
                diagram_caption="$REPLY"
            elif [[ "$line" =~ ^[[:space:]]*::[[:space:]]*(node|term)[[:space:]]*:?[[:space:]]*(.*)$ ]]; then
                local raw_content="${BASH_REMATCH[2]}"
                local -a tokens=()
                __diagram_split_props "$raw_content" tokens
                if (( ${#tokens[@]} == 0 )); then continue; fi

                local name="${tokens[0]}"
                __diagram_strip_quotes_r "$name"; name="$REPLY"

                local x=0 y=0 border="rounded" bg="default" n_class="" n_text=""
                local x_set=0 y_set=0
                local idx token
                for (( idx=1; idx<${#tokens[@]}; idx++ )); do
                    token="${tokens[idx]}"
                    if [[ "$token" == *=* ]]; then
                        local k="${token%%=*}"
                        local v="${token#*=}"
                        __diagram_strip_quotes_r "$v"; v="$REPLY"
                        if [[ "$k" == "x" ]]; then x="$v"; x_set=1
                        elif [[ "$k" == "y" ]]; then y="$v"; y_set=1
                        elif [[ "$k" == "border" ]]; then border="$v"
                        elif [[ "$k" == "bg" ]]; then bg="$v"
                        elif [[ "$k" == "class" ]]; then n_class="$v"
                        elif [[ "$k" == "text" ]]; then n_text="$v"
                        fi
                    else
                        __diagram_strip_quotes_r "$token"
                        local clean_tok="$REPLY"
                        if [[ "$clean_tok" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
                            if (( x_set == 0 )); then x="$clean_tok"; x_set=1
                            elif (( y_set == 0 )); then y="$clean_tok"; y_set=1
                            fi
                        fi
                    fi
                done

                local display_text="${n_text:-$name}"
                __diagram_render_tex "$display_text"
                local text_html="$REPLY_HTML"
                local has_tex="$REPLY_HAS_TEX"
                local tex_w="$REPLY_W_TEX"

                local -a text_lines=()
                if [[ "$display_text" == *"\\n"* ]]; then
                    local split_tmp="${display_text//\\n/$'\x02'}"
                    set -f; IFS=$'\x02'; text_lines=($split_tmp); IFS="$old_ifs"; set +f
                else
                    text_lines=("$display_text")
                fi
                local max_len=0 l_str
                for l_str in "${text_lines[@]}"; do
                    local no_tex="${l_str//\$*\$/}"
                    __char_len "$no_tex"
                    (( REPLY > max_len )) && max_len=$REPLY
                done
                local line_count=${#text_lines[@]}
                (( line_count == 0 )) && line_count=1
                local w=$(( (max_len * 85 + 5) / 10 + tex_w + 28 ))
                (( w < 72 )) && w=72
                local h=$(( line_count * 18 + 18 ))
                (( has_tex == 1 && h < 42 )) && h=42

                node_lines+=("NODE"$'\x1f'"$name"$'\x1f'"$x"$'\x1f'"$y"$'\x1f'"$w"$'\x1f'"$h"$'\x1f'"$border"$'\x1f'"$bg"$'\x1f'"$n_class"$'\x1f'"$has_tex"$'\x1f'"$display_text"$'\x1f'"$text_html")
            elif [[ "$line" =~ ^[[:space:]]*::[[:space:]]*(arrow|2-arrow)[[:space:]]*:?[[:space:]]*(.*)$ ]]; then
                local a_type="${BASH_REMATCH[1]}"
                local raw_content="${BASH_REMATCH[2]}"
                local -a tokens=()
                __diagram_split_props "$raw_content" tokens

                local -a positional=()
                local -a prop_tokens=()
                local token
                for token in "${tokens[@]}"; do
                    if [[ "$token" == *=* ]]; then
                        prop_tokens+=("$token")
                    else
                        __diagram_strip_quotes_r "$token"
                        local clean_tok="$REPLY"
                        if [[ "$clean_tok" == "dotted" || "$clean_tok" == "dashed" || "$clean_tok" == "wavy" || "$clean_tok" == "tilded" || "$clean_tok" == "curly" || "$clean_tok" == "straight" || "$clean_tok" == "diagonal" || "$clean_tok" == "diag" || "$clean_tok" == "normal" ]]; then
                            prop_tokens+=("$clean_tok")
                        else
                            positional+=("$clean_tok")
                        fi
                    fi
                done

                local a_name="" src="" tgt=""
                if (( ${#positional[@]} >= 3 )); then
                    a_name="${positional[0]}"; src="${positional[1]}"; tgt="${positional[2]}"
                elif (( ${#positional[@]} == 2 )); then
                    a_name="${a_type}_${#arrow_lines[@]}"; src="${positional[0]}"; tgt="${positional[1]}"
                elif (( ${#positional[@]} == 1 )); then
                    a_name="${positional[0]}"
                else
                    a_name="${a_type}_${#arrow_lines[@]}"
                fi

                local a_format="normal" a_angle="" a_color="" a_label="" a_label_pos="above" a_size="" a_class="" l_style="continuous"
                local a_x="" a_y="" has_coords=0 a_loop_dir="top"

                for token in "${prop_tokens[@]}"; do
                    if [[ "$token" == *=* ]]; then
                        local k="${token%%=*}"
                        local v="${token#*=}"
                        if [[ "$k" == "label" ]]; then
                            if [[ "$v" == ^* ]]; then a_label_pos="above"; v="${v#^}"
                            elif [[ "$v" == _* ]]; then a_label_pos="below"; v="${v#_}"
                            fi
                            __diagram_strip_quotes_r "$v"; v="$REPLY"
                            if [[ "$v" == ^* ]]; then a_label_pos="above"; v="${v#^}"
                            elif [[ "$v" == _* ]]; then a_label_pos="below"; v="${v#_}"
                            fi
                            a_label="$v"
                        else
                            __diagram_strip_quotes_r "$v"; v="$REPLY"
                            if [[ "$k" == "style" ]]; then l_style="$v"
                            elif [[ "$k" == "format" ]]; then a_format="$v"
                            elif [[ "$k" == "angle" ]]; then a_angle="$v"
                            elif [[ "$k" == "color" ]]; then a_color="$v"
                            elif [[ "$k" == "class" ]]; then a_class="$v"
                            elif [[ "$k" == "source" || "$k" == "s" ]]; then src="$v"
                            elif [[ "$k" == "target" || "$k" == "t" ]]; then tgt="$v"
                            elif [[ "$k" == "size" ]]; then a_size="$v"
                            elif [[ "$k" == "pos" || "$k" == "dir" ]]; then a_loop_dir="$v"
                            elif [[ "$k" == "x" ]]; then a_x="$v"; has_coords=1
                            elif [[ "$k" == "y" ]]; then a_y="$v"; has_coords=1
                            fi
                        fi
                    else
                        if [[ "$token" == "dotted" || "$token" == "dashed" || "$token" == "wavy" || "$token" == "tilded" ]]; then
                            l_style="$token"
                            [[ "$token" == "tilded" ]] && l_style="wavy"
                        elif [[ "$token" == "curly" || "$token" == "straight" || "$token" == "diagonal" || "$token" == "diag" || "$token" == "normal" ]]; then
                            a_format="$token"
                        fi
                    fi
                done
                [[ "$a_format" == "diag" || "$a_format" == "diagonal" ]] && a_format="straight"
                if [[ -z "$a_size" ]]; then
                    if [[ "$a_type" == "2-arrow" ]]; then a_size="0.6"; else a_size="0.9"; fi
                fi

                local label_html="" has_tex=0 label_w=0 label_h=0
                if [[ -n "$a_label" ]]; then
                    __diagram_render_tex "$a_label"
                    label_html="$REPLY_HTML"
                    has_tex="$REPLY_HAS_TEX"
                    local tex_w="$REPLY_W_TEX"

                    local -a lbl_lines=()
                    if [[ "$a_label" == *"\\n"* ]]; then
                        local split_tmp="${a_label//\\n/$'\x02'}"
                        set -f; IFS=$'\x02'; lbl_lines=($split_tmp); IFS="$old_ifs"; set +f
                    else
                        lbl_lines=("$a_label")
                    fi
                    local max_lbl_len=0 l_str
                    for l_str in "${lbl_lines[@]}"; do
                        local no_tex="${l_str//\$*\$/}"
                        __char_len "$no_tex"
                        (( REPLY > max_lbl_len )) && max_lbl_len=$REPLY
                    done
                    local lbl_line_count=${#lbl_lines[@]}
                    (( lbl_line_count == 0 )) && lbl_line_count=1
                    label_w=$(( (max_lbl_len * 85 + 5) / 10 + tex_w + 16 ))
                    label_h=$(( lbl_line_count * 18 ))
                    (( has_tex == 1 && label_h < 28 )) && label_h=28
                fi

                arrow_lines+=("ARROW"$'\x1f'"$a_type"$'\x1f'"$a_name"$'\x1f'"$src"$'\x1f'"$tgt"$'\x1f'"$has_coords"$'\x1f'"$a_x"$'\x1f'"$a_y"$'\x1f'"$a_format"$'\x1f'"$l_style"$'\x1f'"$a_angle"$'\x1f'"$a_color"$'\x1f'"$a_size"$'\x1f'"$a_class"$'\x1f'"$a_label_pos"$'\x1f'"$has_tex"$'\x1f'"$a_label"$'\x1f'"$label_html"$'\x1f'"$label_w"$'\x1f'"$label_h"$'\x1f'"$a_loop_dir")
            fi
        done

        if (( ${#node_lines[@]} == 0 )); then return; fi

        ((page_diagram_count++))
        local diagram_id="diagram-${page_diagram_count}"
        local safe_caption="${diagram_caption//&/&amp;}"
        safe_caption="${safe_caption//</&lt;}"
        safe_caption="${safe_caption//>/&gt;}"
        local aria_label="${safe_caption:-Diagram ${page_diagram_count}}"

        local diagram_svg
        diagram_svg=$(awk -F'\x1F' -v diagram_id="$diagram_id" -v aria_label="$aria_label" '
        function abs(v) { return v < 0 ? -v : v }
        function min(a, b) { return a < b ? a : b }
        function max(a, b) { return a > b ? a : b }

        BEGIN {
            node_count = 0
            arrow_count = 0
            min_x = 999999; max_x = -999999
            min_y = 999999; max_y = -999999
            max_node_w = 72; max_node_h = 36
        }
        $1 == "NODE" {
            node_count++
            name = $2
            node_name[node_count] = name
            node_idx[name] = node_count
            x = $3 + 0; y = $4 + 0
            node_x[node_count] = x
            node_y[node_count] = y
            w = $5 + 0; h = $6 + 0
            node_w[node_count] = w
            node_h[node_count] = h
            node_border[node_count] = $7
            node_bg[node_count] = $8
            node_class[node_count] = $9
            node_has_tex[node_count] = $10 + 0
            node_raw[node_count] = $11
            node_html[node_count] = $12

            min_x = min(min_x, x); max_x = max(max_x, x)
            min_y = min(min_y, y); max_y = max(max_y, y)
            max_node_w = max(max_node_w, w)
            max_node_h = max(max_node_h, h)
            unique_x[x] = 1
            unique_y[y] = 1
        }
        $1 == "ARROW" {
            arrow_count++
            arr_type[arrow_count] = $2
            arr_name[arrow_count] = $3
            arr_src[arrow_count] = $4
            arr_tgt[arrow_count] = $5
            has_c = $6 + 0
            arr_has_coords[arrow_count] = has_c
            ax = $7 + 0; ay = $8 + 0
            arr_x[arrow_count] = ax
            arr_y[arrow_count] = ay
            arr_format[arrow_count] = $9
            arr_style[arrow_count] = $10
            arr_angle_raw[arrow_count] = $11
            arr_color[arrow_count] = $12
            arr_size[arrow_count] = $13 + 0
            arr_class[arrow_count] = $14
            arr_label_pos[arrow_count] = $15
            arr_has_tex[arrow_count] = $16 + 0
            arr_label_raw[arrow_count] = $17
            arr_label_html[arrow_count] = $18
            arr_label_w[arrow_count] = $19 + 0
            arr_label_h[arrow_count] = $20 + 0
            arr_loop_dir[arrow_count] = $21

            if ($4 != "" && $5 != "" && $4 != $5 && !has_c) {
                pair_count[$4 "\x1E" $5]++
            }

            if (has_c) {
                min_x = min(min_x, ax); max_x = max(max_x, ax)
                min_y = min(min_y, ay); max_y = max(max_y, ay)
                unique_x[ax] = 1
                unique_y[ay] = 1
            }
        }
        END {
            if (node_count == 0) exit 0

            n_ux = 0; for (ux in unique_x) { n_ux++; ux_arr[n_ux] = ux + 0 }
            n_uy = 0; for (uy in unique_y) { n_uy++; uy_arr[n_uy] = uy + 0 }

            for (i = 1; i <= n_ux; i++) {
                for (j = i + 1; j <= n_ux; j++) {
                    if (ux_arr[i] > ux_arr[j]) { t = ux_arr[i]; ux_arr[i] = ux_arr[j]; ux_arr[j] = t }
                }
            }
            for (i = 1; i <= n_uy; i++) {
                for (j = i + 1; j <= n_uy; j++) {
                    if (uy_arr[i] > uy_arr[j]) { t = uy_arr[i]; uy_arr[i] = uy_arr[j]; uy_arr[j] = t }
                }
            }

            min_dx = 1
            if (n_ux > 1) {
                min_dx = 999999
                for (i = 1; i < n_ux; i++) {
                    d = ux_arr[i+1] - ux_arr[i]
                    if (d > 0.00001 && d < min_dx) min_dx = d
                }
                if (min_dx == 999999) min_dx = 1
            }
            min_dy = 1
            if (n_uy > 1) {
                min_dy = 999999
                for (i = 1; i < n_uy; i++) {
                    d = uy_arr[i+1] - uy_arr[i]
                    if (d > 0.00001 && d < min_dy) min_dy = d
                }
                if (min_dy == 999999) min_dy = 1
            }

            target_dist_x = max_node_w + 48
            if (target_dist_x < 130) target_dist_x = 130
            target_dist_y = max_node_h + 38
            if (target_dist_y < 76) target_dist_y = 76

            scale_x = (min_dx < 1 ? target_dist_x / min_dx : target_dist_x)
            scale_y = (min_dy < 1 ? target_dist_y / min_dy : target_dist_y)

            padding_x = max_node_w / 2 + 16
            padding_y = max_node_h / 2 + 16

            bound_min_x = 999999; bound_max_x = -999999
            bound_min_y = 999999; bound_max_y = -999999

            for (i = 1; i <= node_count; i++) {
                px = (node_x[i] - min_x) * scale_x + padding_x
                py = (max_y - node_y[i]) * scale_y + padding_y
                nm = node_name[i]
                terms_x[nm] = px
                terms_y[nm] = py
                terms_w[nm] = node_w[i]
                terms_h[nm] = node_h[i]

                bound_min_x = min(bound_min_x, px - node_w[i] / 2)
                bound_max_x = max(bound_max_x, px + node_w[i] / 2)
                bound_min_y = min(bound_min_y, py - node_h[i] / 2)
                bound_max_y = max(bound_max_y, py + node_h[i] / 2)
            }

            wavy_id = diagram_id "-wavy"
            defs_html = "<defs>\n" \
                "    <filter id=\"" wavy_id "\" filterUnits=\"userSpaceOnUse\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n" \
                "        <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.05\" numOctaves=\"1\" result=\"noise\"/>\n" \
                "        <feDisplacementMap in=\"SourceGraphic\" in2=\"noise\" scale=\"5\" xChannelSelector=\"R\" yChannelSelector=\"G\"/>\n" \
                "    </filter>\n" \
                "</defs>"

            layer_arrows = ""
            layer_labels = ""

            for (pass = 1; pass <= 2; pass++) {
                for (i = 1; i <= arrow_count; i++) {
                    atype = arr_type[i]
                    if (pass == 1 && atype == "2-arrow") continue
                    if (pass == 2 && atype == "arrow") continue

                    aname = arr_name[i]
                    src = arr_src[i]
                    tgt = arr_tgt[i]
                    has_c = arr_has_coords[i]

                    has_src = (src in terms_x)
                    has_tgt = (tgt in terms_x)

                    if (!has_src && has_c) {
                        sx = (arr_x[i] - min_x) * scale_x + padding_x
                        sy = (max_y - arr_y[i]) * scale_y + padding_y
                        hw_s = 0; hh_s = 0
                        has_src = 1
                    } else if (has_src) {
                        sx = terms_x[src]; sy = terms_y[src]
                        hw_s = terms_w[src] / 2; hh_s = terms_h[src] / 2
                    }

                    if (!has_tgt && has_c) {
                        tx = (arr_x[i] - min_x) * scale_x + padding_x
                        ty = (max_y - arr_y[i]) * scale_y + padding_y
                        hw_t = 0; hh_t = 0
                        has_tgt = 1
                    } else if (has_tgt) {
                        tx = terms_x[tgt]; ty = terms_y[tgt]
                        hw_t = terms_w[tgt] / 2; hh_t = terms_h[tgt] / 2
                    }

                    if (!has_src || !has_tgt) {
                        if (has_c) {
                            apx = (arr_x[i] - min_x) * scale_x + padding_x
                            apy = (max_y - arr_y[i]) * scale_y + padding_y
                            terms_x[aname] = apx; terms_y[aname] = apy
                            terms_w[aname] = 0; terms_h[aname] = 0
                        }
                        continue
                    }

                    a_format = arr_format[i]
                    l_style = arr_style[i]
                    a_color = arr_color[i]
                    a_size = arr_size[i]
                    a_class = arr_class[i]
                    a_label_pos = arr_label_pos[i]
                    has_tex = arr_has_tex[i]
                    label_raw = arr_label_raw[i]
                    label_html = arr_label_html[i]
                    loop_dir = arr_loop_dir[i]

                    has_angle = (arr_angle_raw[i] != "")
                    a_angle = (has_angle ? arr_angle_raw[i] + 0 : 45)
                    auto_curved = 0
                    if (!has_c && src != tgt && a_format == "normal") {
                        fwd = pair_count[src "\x1E" tgt] + 0
                        rev = pair_count[tgt "\x1E" src] + 0
                        if (rev > 0 || fwd > 1) {
                            a_format = "curly"
                            if (!has_angle) {
                                a_angle = 20
                                auto_curved = 1
                            }
                            if (fwd > 1) {
                                pair_seen[src "\x1E" tgt]++
                                idx_p = pair_seen[src "\x1E" tgt]
                                if (idx_p % 2 == 0) a_angle = -a_angle * (idx_p / 2)
                                else if (idx_p > 1) a_angle = a_angle * ((idx_p + 1) / 2)
                            }
                        }
                    }

                    path_id = diagram_id "-path-" (i - 1)
                    marker_id = diagram_id "-marker-" (i - 1)
                    path_class_attr = " class=\"diagram-path" (a_class != "" ? " " a_class : "") "\""
                    path_color_attr = ""
                    marker_fill_attr = " class=\"diagram-marker" (a_class != "" ? " " a_class : "") "\""
                    label_class_attr = " class=\"diagram-text diagram-label" (a_class != "" ? " " a_class : "") "\""
                    label_color_attr = ""

                    if (a_color != "" && a_color != "currentColor") {
                        path_class_attr = (a_class != "" ? " class=\"" a_class "\"" : "")
                        path_color_attr = " stroke=\"" a_color "\""
                        marker_fill_attr = (a_class != "" ? " class=\"" a_class "\"" : "") " fill=\"" a_color "\""
                        label_color_attr = " fill=\"" a_color "\""
                    }

                    if (atype == "2-arrow") {
                        m_stroke = " class=\"diagram-path" (a_class != "" ? " " a_class : "") "\""
                        if (a_color != "" && a_color != "currentColor") m_stroke = (a_class != "" ? " class=\"" a_class "\"" : "") " stroke=\"" a_color "\""
                        defs_html = defs_html "<marker id=\"" marker_id "\" viewBox=\"0 0 10 10\" refX=\"6\" refY=\"5\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto-start-reverse\"><path d=\"M 0 1 L 7 5 L 0 9\" fill=\"none\"" m_stroke " stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></marker>\n"
                    } else {
                        defs_html = defs_html "<marker id=\"" marker_id "\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\"" marker_fill_attr "/></marker>\n"
                    }

                    d_path = ""
                    mx = 0; my = 0
                    tan_x = 0; tan_y = 0

                    if (src == tgt) {
                        if (loop_dir == "bottom") {
                            d_path = sprintf("M %.1f %.1f C %.1f %.1f, %.1f %.1f, %.1f %.1f", sx - 8, sy + hh_s, sx - 28, sy + hh_s + 40, sx + 28, sy + hh_s + 40, sx + 8, sy + hh_s + 2)
                            mx = sx; my = sy + hh_s + 30
                            tan_x = 1; tan_y = 0
                            a_label_pos = "below"
                            bound_min_x = min(bound_min_x, sx - 28); bound_max_x = max(bound_max_x, sx + 28)
                            bound_max_y = max(bound_max_y, sy + hh_s + 40)
                        } else if (loop_dir == "left") {
                            d_path = sprintf("M %.1f %.1f C %.1f %.1f, %.1f %.1f, %.1f %.1f", sx - hw_s, sy - 8, sx - hw_s - 42, sy - 26, sx - hw_s - 42, sy + 26, sx - hw_s - 2, sy + 8)
                            mx = sx - hw_s - 31; my = sy
                            tan_x = 0; tan_y = 1
                            bound_min_x = min(bound_min_x, sx - hw_s - 42)
                            bound_min_y = min(bound_min_y, sy - 26); bound_max_y = max(bound_max_y, sy + 26)
                        } else if (loop_dir == "right") {
                            d_path = sprintf("M %.1f %.1f C %.1f %.1f, %.1f %.1f, %.1f %.1f", sx + hw_s, sy - 8, sx + hw_s + 42, sy - 26, sx + hw_s + 42, sy + 26, sx + hw_s + 2, sy + 8)
                            mx = sx + hw_s + 31; my = sy
                            tan_x = 0; tan_y = 1
                            a_label_pos = "below"
                            bound_max_x = max(bound_max_x, sx + hw_s + 42)
                            bound_min_y = min(bound_min_y, sy - 26); bound_max_y = max(bound_max_y, sy + 26)
                        } else {
                            d_path = sprintf("M %.1f %.1f C %.1f %.1f, %.1f %.1f, %.1f %.1f", sx - 8, sy - hh_s, sx - 28, sy - hh_s - 40, sx + 28, sy - hh_s - 40, sx + 8, sy - hh_s - 2)
                            mx = sx; my = sy - hh_s - 30
                            tan_x = 1; tan_y = 0
                            bound_min_x = min(bound_min_x, sx - 28); bound_max_x = max(bound_max_x, sx + 28)
                            bound_min_y = min(bound_min_y, sy - hh_s - 40)
                        }
                    } else {
                        dx = tx - sx; dy = ty - sy
                        chord_len = sqrt(dx*dx + dy*dy)
                        if (chord_len == 0) chord_len = 1
                        sign_dx = (dx < 0 ? -1 : (dx > 0 ? 1 : 0))
                        sign_dy = (dy < 0 ? -1 : (dy > 0 ? 1 : 0))

                        if (has_c) {
                            cx = (arr_x[i] - min_x) * scale_x + padding_x
                            cy = (max_y - arr_y[i]) * scale_y + padding_y
                        } else if (a_format == "curly") {
                            curve_bulge = (chord_len * a_angle) / 100
                            if (auto_curved && abs(curve_bulge) > 70) {
                                curve_bulge = (curve_bulge < 0 ? -70 : 70)
                            }
                            cx = (sx + tx)/2 - (dy / chord_len) * curve_bulge
                            cy = (sy + ty)/2 + (dx / chord_len) * curve_bulge
                        } else {
                            cx = (sx + tx)/2
                            cy = (sy + ty)/2
                        }

                        if (a_format != "normal" || has_c) {
                            dx_s = cx - sx; dy_s = cy - sy
                            L_s = sqrt(dx_s*dx_s + dy_s*dy_s); if (L_s == 0) L_s = 1
                            dx_t = tx - cx; dy_t = ty - cy
                            L_t = sqrt(dx_t*dx_t + dy_t*dy_t); if (L_t == 0) L_t = 1

                            abs_dx_s = abs(dx_s); abs_dy_s = abs(dy_s)
                            dist_s = 0
                            if (abs_dx_s > 0 || abs_dy_s > 0) {
                                if (abs_dx_s * hh_s > abs_dy_s * hw_s) dist_s = (abs_dx_s > 0 ? hw_s * L_s / abs_dx_s : 0)
                                else dist_s = (abs_dy_s > 0 ? hh_s * L_s / abs_dy_s : 0)
                            }

                            abs_dx_t = abs(dx_t); abs_dy_t = abs(dy_t)
                            dist_t = 0
                            if (abs_dx_t > 0 || abs_dy_t > 0) {
                                if (abs_dx_t * hh_t > abs_dy_t * hw_t) dist_t = (abs_dx_t > 0 ? hw_t * L_t / abs_dx_t : 0)
                                else dist_t = (abs_dy_t > 0 ? hh_t * L_t / abs_dy_t : 0)
                            }

                            gap_s = dist_s + L_s * (1 - a_size) / 2
                            gap_t = dist_t + L_t * (1 - a_size) / 2
                            if (gap_s > L_s - 2) gap_s = L_s - 2
                            if (gap_t > L_t - 2) gap_t = L_t - 2

                            nsx = sx + dx_s * gap_s / L_s
                            nsy = sy + dy_s * gap_s / L_s
                            ntx = tx - dx_t * gap_t / L_t
                            nty = ty - dy_t * gap_t / L_t

                            if (a_format == "curly" || has_c) {
                                d_path = sprintf("M %.1f %.1f Q %.1f %.1f %.1f %.1f", nsx, nsy, cx, cy, ntx, nty)
                                mx = (nsx + 2 * cx + ntx) / 4
                                my = (nsy + 2 * cy + nty) / 4
                                tan_x = ntx - nsx; tan_y = nty - nsy
                                bound_min_x = min(bound_min_x, mx)
                                bound_max_x = max(bound_max_x, mx)
                                bound_min_y = min(bound_min_y, my)
                                bound_max_y = max(bound_max_y, my)
                            } else {
                                d_path = sprintf("M %.1f %.1f L %.1f %.1f", nsx, nsy, ntx, nty)
                                mx = (nsx + ntx)/2
                                my = (nsy + nty)/2
                                tan_x = ntx - nsx; tan_y = nty - nsy
                            }
                        } else {
                            if (sy == ty) {
                                esx = sx + sign_dx * hw_s
                                etx = tx - sign_dx * hw_t
                                L_orth = abs(etx - esx)
                                gap = L_orth * (1 - a_size) / 2
                                nsx = esx + sign_dx * gap
                                ntx = etx - sign_dx * gap
                                nsy = sy; nty = ty
                                d_path = sprintf("M %.1f %.1f L %.1f %.1f", nsx, sy, ntx, ty)
                                tan_x = ntx - nsx; tan_y = 0
                            } else if (sx == tx) {
                                esy = sy + sign_dy * hh_s
                                ety = ty - sign_dy * hh_t
                                L_orth = abs(ety - esy)
                                gap = L_orth * (1 - a_size) / 2
                                nsy = esy + sign_dy * gap
                                nty = ety - sign_dy * gap
                                nsx = sx; ntx = tx
                                d_path = sprintf("M %.1f %.1f L %.1f %.1f", sx, nsy, tx, nty)
                                tan_x = 0; tan_y = nty - nsy
                            } else {
                                esx = sx + sign_dx * hw_s
                                ety = ty - sign_dy * hh_t
                                abs_tx_esx = abs(tx - esx)
                                abs_ety_sy = abs(ety - sy)
                                L_orth = abs_tx_esx + abs_ety_sy
                                gap = L_orth * (1 - a_size) / 2
                                if (gap <= abs_tx_esx) { nsx = esx + sign_dx * gap; nsy = sy }
                                else { nsx = tx; nsy = sy + sign_dy * (gap - abs_tx_esx) }
                                if (gap <= abs_ety_sy) { ntx = tx; nty = ety - sign_dy * gap }
                                else { ntx = tx - sign_dx * (gap - abs_ety_sy); nty = sy }

                                if (nsy == sy && ntx == tx) d_path = sprintf("M %.1f %.1f L %.1f %.1f L %.1f %.1f", nsx, nsy, tx, sy, ntx, nty)
                                else if ((nsy != sy && ntx == tx) || (nsy == sy && ntx != tx)) d_path = sprintf("M %.1f %.1f L %.1f %.1f", nsx, nsy, ntx, nty)
                                else d_path = sprintf("M %.1f %.1f L %.1f %.1f L %.1f %.1f", nsx, nsy, tx, sy, ntx, nty)

                                tan_x = ntx - nsx; tan_y = nty - nsy
                            }
                            mx = (nsx + ntx)/2
                            my = (nsy + nty)/2
                        }
                    }

                    terms_x[aname] = mx; terms_y[aname] = my
                    terms_w[aname] = 14; terms_h[aname] = 14

                    path_props = ""
                    if (l_style == "dashed") path_props = " stroke-dasharray=\"6,6\""
                    else if (l_style == "dotted") path_props = " stroke-dasharray=\"0,7\" stroke-linecap=\"round\""
                    else if (l_style == "wavy") path_props = " filter=\"url(#" wavy_id ")\""

                    if (atype == "2-arrow") {
                        d_shaft = d_path
                        if (src != tgt && a_format != "curly" && !has_c) {
                            s_dx = ntx - nsx; s_dy = nty - nsy
                            s_len = sqrt(s_dx*s_dx + s_dy*s_dy)
                            if (s_len > 6) {
                                stx = ntx - (s_dx / s_len) * 2.5
                                sty = nty - (s_dy / s_len) * 2.5
                                d_shaft = sprintf("M %.1f %.1f L %.1f %.1f", nsx, nsy, stx, sty)
                            }
                        }
                        layer_arrows = layer_arrows "<path id=\"" path_id "\" d=\"" d_shaft "\" fill=\"none\"" path_class_attr path_color_attr " stroke-width=\"3\"" path_props " />\n"
                        layer_arrows = layer_arrows "<path d=\"" d_shaft "\" fill=\"none\" class=\"diagram-bg-stroke\" stroke-width=\"1.5\"" path_props " />\n"
                    } else {
                        layer_arrows = layer_arrows "<path id=\"" path_id "\" d=\"" d_path "\" fill=\"none\"" path_class_attr path_color_attr " stroke-width=\"1.5\"" path_props " />\n"
                    }
                    layer_arrows = layer_arrows "<path d=\"" d_path "\" fill=\"none\" stroke=\"none\" marker-end=\"url(#" marker_id ")\" />\n"

                    if (label_raw != "") {
                        tan_len = sqrt(tan_x * tan_x + tan_y * tan_y)
                        if (tan_len == 0) tan_len = 1
                        ux = tan_x / tan_len; uy = tan_y / tan_len
                        nx = -uy; ny = ux
                        if (ny > 0 || (ny == 0 && nx > 0)) { nx = -nx; ny = -ny }
                        dist_lbl = 15
                        if (a_label_pos == "below") { lx = mx - dist_lbl * nx; ly = my - dist_lbl * ny }
                        else { lx = mx + dist_lbl * nx; ly = my + dist_lbl * ny }

                        txt_anchor = "middle"
                        if (abs(ny) < 0.5) {
                            if (lx > mx) { txt_anchor = "start"; lx = mx + 10 }
                            else { txt_anchor = "end"; lx = mx - 10 }
                        }

                        lbl_w = max(arr_label_w[i], 32)
                        lbl_h = max(arr_label_h[i], 18)
                        if (txt_anchor == "start") {
                            lbl_x1 = lx
                            lbl_x2 = lx + lbl_w
                        } else if (txt_anchor == "end") {
                            lbl_x1 = lx - lbl_w
                            lbl_x2 = lx
                        } else {
                            lbl_x1 = lx - lbl_w / 2
                            lbl_x2 = lx + lbl_w / 2
                        }
                        lbl_y1 = ly - lbl_h / 2
                        lbl_y2 = ly + lbl_h / 2

                        bound_min_x = min(bound_min_x, lbl_x1)
                        bound_max_x = max(bound_max_x, lbl_x2)
                        bound_min_y = min(bound_min_y, lbl_y1)
                        bound_max_y = max(bound_max_y, lbl_y2)

                        if (has_tex) {
                            gsub(/\\n/, "<br/>", label_html)
                            lbl_x = lbl_x1
                            lbl_y = lbl_y1
                            fo_class = "diagram-label-tex" (a_class != "" ? " " a_class : "")
                            layer_labels = layer_labels "<foreignObject x=\"" lbl_x "\" y=\"" lbl_y "\" width=\"" lbl_w "\" height=\"" lbl_h "\" style=\"overflow: visible;\"><div xmlns=\"http://www.w3.org/1999/xhtml\" class=\"" fo_class "\" style=\"display: inline-flex; flex-direction: column; align-items: " (txt_anchor == "start" ? "flex-start" : (txt_anchor == "end" ? "flex-end" : "center")) "; justify-content: center; text-align: " (txt_anchor == "start" ? "left" : (txt_anchor == "end" ? "right" : "center")) "; width: 100%; height: 100%; background: var(--bg, #ffffff); border-radius: 3px; padding: 1px 4px; font-family: var(--family-diagram, monospace); font-size: 14px; pointer-events: none;\">" label_html "</div></foreignObject>\n"
                        } else {
                            n_lines = split(label_raw, l_arr, "\\\\n")
                            if (n_lines <= 1) {
                                layer_labels = layer_labels "<text x=\"" lx "\" y=\"" ly "\" text-anchor=\"" txt_anchor "\" dominant-baseline=\"central\"" label_class_attr label_color_attr ">" label_raw "</text>\n"
                            } else {
                                line_height = 18
                                start_dy = - (n_lines - 1) * line_height / 2
                                tspans = ""
                                for (l = 1; l <= n_lines; l++) {
                                    ldy = (l == 1 ? start_dy : line_height)
                                    tspans = tspans "<tspan x=\"" lx "\" dy=\"" ldy "\">" l_arr[l] "</tspan>"
                                }
                                layer_labels = layer_labels "<text x=\"" lx "\" y=\"" ly "\" text-anchor=\"" txt_anchor "\" dominant-baseline=\"central\"" label_class_attr label_color_attr ">" tspans "</text>\n"
                            }
                        }
                    }
                }
            }

            layer_nodes = ""
            for (i = 1; i <= node_count; i++) {
                nm = node_name[i]
                tx = terms_x[nm]; ty = terms_y[nm]
                w = terms_w[nm]; h = terms_h[nm]
                bx = tx - w / 2; by = ty - h / 2

                border = node_border[i]
                bg = node_bg[i]
                n_class = node_class[i]
                has_tex = node_has_tex[i]
                raw_text = node_raw[i]
                html_text = node_html[i]

                rx = 18
                if (border == "squared") rx = 4
                if (border == "none" || border == "") rx = 0

                inline_style = ""
                if (bg == "none") inline_style = inline_style "fill: none; "
                else if (bg != "default" && bg != "") inline_style = inline_style "fill: " bg "; "

                if (border == "none" || border == "") inline_style = inline_style "stroke: none; "
                style_attr = (inline_style != "" ? " style=\"" inline_style "\"" : "")

                layer_nodes = layer_nodes "<rect x=\"" bx "\" y=\"" by "\" width=\"" w "\" height=\"" h "\" rx=\"" rx "\" class=\"diagram-node" (n_class != "" ? " " n_class : "") "\" stroke-width=\"1.5\"" style_attr " />\n"

                if (has_tex) {
                    gsub(/\\n/, "<br/>", html_text)
                    layer_nodes = layer_nodes "<foreignObject x=\"" bx "\" y=\"" by "\" width=\"" w "\" height=\"" h "\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; text-align: center; font-family: var(--family-diagram, monospace); font-size: 14px; pointer-events: none;\">" html_text "</div></foreignObject>\n"
                } else {
                    n_lines = split(raw_text, l_arr, "\\\\n")
                    if (n_lines <= 1) {
                        layer_nodes = layer_nodes "<text x=\"" tx "\" y=\"" ty "\" text-anchor=\"middle\" dominant-baseline=\"central\" class=\"diagram-text" (n_class != "" ? " " n_class : "") "\"><tspan x=\"" tx "\" dy=\"0\">" raw_text "</tspan></text>\n"
                    } else {
                        line_height = 18
                        start_dy = - (n_lines - 1) * line_height / 2
                        tspans = ""
                        for (l = 1; l <= n_lines; l++) {
                            ldy = (l == 1 ? start_dy : line_height)
                            tspans = tspans "<tspan x=\"" tx "\" dy=\"" ldy "\">" l_arr[l] "</tspan>"
                        }
                        layer_nodes = layer_nodes "<text x=\"" tx "\" y=\"" ty "\" text-anchor=\"middle\" dominant-baseline=\"central\" class=\"diagram-text" (n_class != "" ? " " n_class : "") "\">" tspans "</text>\n"
                    }
                }
            }

            margin = 4
            bound_min_x -= margin
            bound_max_x += margin
            bound_min_y -= margin
            bound_max_y += margin

            final_w = bound_max_x - bound_min_x
            final_h = bound_max_y - bound_min_y

            printf "<div id=\"%s\" class=\"diagram-container\" style=\"overflow-x: auto;\">\n", diagram_id
            printf "<svg role=\"img\" aria-label=\"%s\" width=\"%.0f\" height=\"%.0f\" viewBox=\"%.0f %.0f %.0f %.0f\" xmlns=\"http://www.w3.org/2000/svg\" style=\"max-width: none; display: block;\">\n", aria_label, final_w, final_h, bound_min_x, bound_min_y, final_w, final_h
            printf "<style>\n"
            printf "    #%s .diagram-node { fill: var(--bg-code, #ffffff); stroke: var(--gray4, #333333); }\n", diagram_id
            printf "    #%s .diagram-text, #%s .diagram-text * { fill: var(--fg, #333333); font-family: var(--family-diagram, monospace) !important; font-size: 14px; }\n", diagram_id, diagram_id
            printf "    #%s .diagram-label, #%s .diagram-label * { paint-order: stroke fill; stroke: var(--bg-code, #ffffff); stroke-width: 4px; stroke-linejoin: round; }\n", diagram_id, diagram_id
            printf "    #%s .diagram-path { stroke: var(--gray4, #333333); }\n", diagram_id
            printf "    #%s .diagram-bg-stroke { stroke: var(--bg, #ffffff); }\n", diagram_id
            printf "    #%s .diagram-marker { fill: var(--gray4, #333333); }\n", diagram_id
            printf "    #%s text, #%s tspan { font-family: var(--family-diagram, monospace) !important; font-size: 14px !important; }\n", diagram_id, diagram_id
            printf "    #%s .latex-inline svg { vertical-align: middle; }\n", diagram_id
            printf "</style>\n"
            printf "%s\n", defs_html
            printf "%s", layer_arrows
            printf "%s", layer_labels
            printf "%s", layer_nodes
            printf "</svg>"
        }
        ' <<< "$(printf "%s\n" "${node_lines[@]}" "${arrow_lines[@]}")")

        if [[ -n "$safe_caption" ]]; then
            diagram_svg+=$'\n'"<p><a href=\"#${diagram_id}\" class=\"diagram-caption\">${safe_caption}</a></p>"
        fi
        diagram_svg+=$'\n'"</div>"

        content+="${diagram_svg}"$'\n'
        LIST_HTML_MAP["diagram"]+="<li><a href=\"#${diagram_id}\">Diagram ${page_diagram_count}</a></li>"$'\n'
    }   

    __block_plain() {
        local bname="$1"
        local -n _buffer_ref="$2"
                 
        if [[ ${#_buffer_ref[@]} -eq 0 ]]; then return; fi
        local old_ifs="$IFS"
        IFS=$'\n'
        local html="<plain style=\"white-space: pre; overflow-x: auto; display: block;\">"$'\n'"${_buffer_ref[*]}"$'\n'"</plain>"$'\n'
        IFS="$old_ifs"
        content+="${html}"
    }

    __block_pre() {
        local bname="$1"
        local -n _buffer_ref="$2"
        
        if [[ ${#_buffer_ref[@]} -eq 0 ]]; then return; fi
        
        local old_ifs="$IFS"
        IFS=$'\n'
        local escaped_text="${_buffer_ref[*]}"
        IFS="$old_ifs"
        
        escaped_text="${escaped_text//&/&amp;}"
        escaped_text="${escaped_text//</&lt;}"
        escaped_text="${escaped_text//>/&gt;}"
        
        local html="<pre class=\"block-pre\" style=\"white-space: pre; overflow-x: auto; display: block;\">"$'\n'"${escaped_text}"$'\n'"</pre>"$'\n'
        
        content+="${html}"
    }

    __block_tex() {
        local bname="$1"
        local -n _buffer_ref="$2"

        (( ${#_buffer_ref[@]} == 0 )) && return 0

        local IFS=$'\n'
        local tex_content="${_buffer_ref[*]}"

        local svg_output="${LATEX_MEM_CACHE["block:${tex_content}"]:-}"
        if [[ -z "$svg_output" ]]; then
            svg_output=$("$_WIKI_DIR/bin/latex" --stdout --dpr 0.4 <<< "$tex_content")
            svg_output="${svg_output//rgba(0,0,0,1)/var(--fg)}"
            LATEX_MEM_CACHE["block:${tex_content}"]="$svg_output"
        fi

        content+="<div class=\"latex\">"$'\n'"${svg_output}"$'\n'"</div>"$'\n'
    }   

    __get_style_attr_r() {
        local b_width="$1" b_style="$2"
        local inline_style=""
        if [[ -n "$b_width" ]]; then
            if [[ "$b_width" == *"="* ]]; then
                local prev_IFS="$IFS"
                IFS=','
                local w_tokens=($b_width)
                IFS="$prev_IFS"
                local w_tok
                for w_tok in "${w_tokens[@]}"; do
                    w_tok="${w_tok#"${w_tok%%[![:space:]]*}"}"
                    w_tok="${w_tok%"${w_tok##*[![:space:]]}"}"
                    local prop="${w_tok%%=*}"
                    local val="${w_tok#*=}"
                    [[ "$val" =~ ^[0-9]+$ ]] && val="${val}px"
                    if [[ "$prop" == "max" ]]; then inline_style+="max-width:${val};"
                    elif [[ "$prop" == "min" ]]; then inline_style+="min-width:${val};"
                    elif [[ "$prop" == "width" ]]; then inline_style+="width:${val};"
                    fi
                done
            else
                [[ "$b_width" =~ ^[0-9]+$ ]] && b_width="${b_width}px"
                inline_style+="width:${b_width};"
            fi
        fi
        if [[ -n "$b_style" ]]; then
            inline_style+="${b_style}"
            [[ "${inline_style: -1}" != ";" && -n "$inline_style" ]] && inline_style+=";"
        fi
        if [[ -n "$inline_style" ]]; then
            REPLY=" style=\"${inline_style}\""
        else
            REPLY=""
        fi
    }

    __get_style_attr() {
        __get_style_attr_r "$@"
        printf '%s' "$REPLY"
    }

    __block_image() {
        local bname="$1"
        local -n img_buffer_ref="$2"
        if (( ${#img_buffer_ref[@]} == 0 )); then return; fi
        local b_id="rnd-$RANDOM"
        local b_img="" b_alt="" b_cap="" b_width="" b_style="" b_align=""
        local i_width="" i_style=""
        local current_key="" current_val="" b_line l_trim after_col k_part v_part
        for b_line in "${img_buffer_ref[@]}"; do
            l_trim="${b_line#"${b_line%%[![:space:]]*}"}"
            if [[ "$l_trim" == "::"* ]]; then
                after_col="${l_trim#::}"
                after_col="${after_col#"${after_col%%[![:space:]]*}"}"
                if [[ "$after_col" == *:* ]]; then
                    k_part="${after_col%%:*}"
                    if [[ -n "$k_part" && -z "${k_part//[a-zA-Z0-9_-]/}" ]]; then
                        if [[ -n "$current_key" ]]; then
                            case "$current_key" in
                                __id__) b_id="$current_val" ;;
                                image) b_img="$current_val" ;;
                                alt) b_alt="$current_val" ;;
                                __caption__) b_cap="$current_val" ;;
                                align) b_align="$current_val" ;;
                                __width__) b_width="$current_val" ;;
                                __style__) b_style="$current_val" ;;
                                width) i_width="$current_val" ;;
                                style) i_style="$current_val" ;;
                            esac
                        fi
                        current_key="$k_part"
                        v_part="${after_col#*:}"
                        v_part="${v_part#"${v_part%%[![:space:]]*}"}"
