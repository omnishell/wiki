                icon_html="$(curl -sL "$s_icon")"
            elif [[ "$s_icon" == *.svg ]]; then
                if [[ -f "$s_icon" ]]; then
                    icon_html="$(<"$s_icon")"
                elif [[ -f "$SOURCEDIR/$s_icon" ]]; then
                    icon_html="$(<"$SOURCEDIR/$s_icon")"
                fi
