    __partial_head_r() {
        local h_title="" h_css="" h_js="" h_thumb=""
        local str="$*"
        while [[ "$str" =~ ([a-zA-Z_.-]+)=([^\"\'[:space:]]+|\"([^\"]+)\"|\'([^\']+)\') ]]; do
            local key="${BASH_REMATCH[1]}"
            local val="${BASH_REMATCH[4]:-${BASH_REMATCH[3]:-${BASH_REMATCH[2]}}}"
            [[ "$val" == page.* ]] && val="${PAGE_VARS[$val]}"
            if [[ "$key" == "title" ]]; then h_title="$val"
            elif [[ "$key" == "css" ]]; then h_css="$val"
            elif [[ "$key" == "js" ]]; then h_js="$val"
            elif [[ "$key" == "thumb" ]]; then h_thumb="$val"
            fi
            str="${str#*${BASH_REMATCH[0]}}"
        done
        if [[ -n "$h_thumb" && "$h_thumb" != http://* && "$h_thumb" != https://* && "$h_thumb" != /* ]]; then
            h_thumb="/_assets/${h_thumb}"
        fi
        local out="<meta charset=\"UTF-8\">"$'\n'
        out+="<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">"$'\n'
        out+="<title>${h_title}</title>"$'\n'
        local -a h_css_list=()
        IFS=',' read -ra h_css_list <<< "$h_css"
        (( ${#h_css_list[@]} )) || h_css_list=("")
        local h_css_item
        for h_css_item in "${h_css_list[@]}"; do
            out+="<link rel=\"stylesheet\" href=\"${h_css_item}\">"$'\n'
        done
        out+="<link rel=\"icon\" type=\"image/png\" href=\"/_static/favicon/favicon-96x96.png\" sizes=\"96x96\">"$'\n'
        out+="<link rel=\"icon\" type=\"image/svg+xml\" href=\"/_static/favicon/favicon.svg\">"$'\n'
        out+="<link rel=\"shortcut icon\" href=\"/_static/favicon/favicon.ico\">"$'\n'
        out+="<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/_static/favicon/apple-touch-icon.png\">"$'\n'
        out+="<meta name=\"apple-mobile-web-app-title\" content=\"ximenesyuri\">"$'\n'
        out+="<link rel=\"manifest\" href=\"/_static/favicon/site.webmanifest\">"$'\n'
        out+="<script type=\"module\" src=\"${h_js}\"></script>"$'\n'
        if [[ -n "$h_thumb" ]]; then
            out+="<meta property=\"og:title\" content=\"${h_title}\">"$'\n'
            out+="<meta property=\"og:image\" content=\"${h_thumb}\">"$'\n'
            out+="<meta name=\"twitter:card\" content=\"summary_large_image\">"$'\n'
            out+="<meta name=\"twitter:title\" content=\"${h_title}\">"$'\n'
            out+="<meta name=\"twitter:image\" content=\"${h_thumb}\">"$'\n'
        fi
        out+="<script>
        window.addEventListener('hashchange', function() {
            var m = document.getElementById('search-modal');
            if (m) m.style.display = 'none';
            var r = document.getElementById('search-results');
            if (r) r.style.display = 'none';
        });
        document.addEventListener('DOMContentLoaded', async function() {
            if (window.matchMedia(\"(max-width: 768px)\").matches) {
                document.querySelectorAll('.menu-details > details[open]').forEach(function(details){
                    details.removeAttribute('open');
                });
            }
            wiki.full(true);
        });
    </script>"$'\n'
        out+="</head>"
        REPLY="$out"
        return 0
    }
   

    __partial_head() {
        __partial_head_r "$@"
        printf "%s" "$REPLY"
    }

    __partial_settings() {
        local s_label="" s_icon="" s_content_align="" s_content_align_desc="" s_button="true"
        local s_themes_selector="false" s_themes_path="" s_themes_desc="tema"
        local str="$*"
        while [[ "$str" =~ ([a-zA-Z_.-]+)=([^\"\'[:space:]]+|\"([^\"]+)\"|\'([^\']+)\') ]]; do
            local key="${BASH_REMATCH[1]}"
            local val="${BASH_REMATCH[4]:-${BASH_REMATCH[3]:-${BASH_REMATCH[2]}}}"
            if [[ "$key" == "label" ]]; then s_label="$val"
            elif [[ "$key" == "icon" ]]; then s_icon="$val"
            elif [[ "$key" == "content_align" ]]; then s_content_align="${val,,}"
            elif [[ "$key" == "content_align_desc" ]]; then s_content_align_desc="$val"
            elif [[ "$key" == "button" ]]; then s_button="${val,,}"
            elif [[ "$key" == "themes_selector" ]]; then s_themes_selector="${val,,}"
            elif [[ "$key" == "themes_path" ]]; then s_themes_path="$val"
            elif [[ "$key" == "themes_desc" ]]; then s_themes_desc="$val"
            fi
