            WIKI_SETTINGS_HTML+="                <div class=\"settings-segmented\" role=\"radiogroup\" aria-labelledby=\"settings-content-align\">"$'\n'
            WIKI_SETTINGS_HTML+="                <button type=\"button\" role=\"radio\" data-value=\"left\" aria-label=\"à esquerda\" aria-checked=\"false\" tabindex=\"-1\">"$'\n'
            WIKI_SETTINGS_HTML+="                    <svg viewBox=\"0 0 20 16\" width=\"20\" height=\"16\" aria-hidden=\"true\"><rect x=\"0.5\" y=\"0.5\" width=\"19\" height=\"15\" fill=\"none\" stroke=\"currentColor\"/><rect x=\"3\" y=\"4\" width=\"5\" height=\"8\" fill=\"currentColor\"/></svg>"$'\n'
            WIKI_SETTINGS_HTML+="                </button>"$'\n'
            WIKI_SETTINGS_HTML+="                <button type=\"button\" role=\"radio\" data-value=\"center\" aria-label=\"centralizado\" aria-checked=\"false\" tabindex=\"-1\">"$'\n'
            WIKI_SETTINGS_HTML+="                    <svg viewBox=\"0 0 20 16\" width=\"20\" height=\"16\" aria-hidden=\"true\"><rect x=\"0.5\" y=\"0.5\" width=\"19\" height=\"15\" fill=\"none\" stroke=\"currentColor\"/><rect x=\"7.5\" y=\"4\" width=\"5\" height=\"8\" fill=\"currentColor\"/></svg>"$'\n'
            WIKI_SETTINGS_HTML+="                </button>"$'\n'
            WIKI_SETTINGS_HTML+="                <button type=\"button\" role=\"radio\" data-value=\"right\" aria-label=\"à direita\" aria-checked=\"false\" tabindex=\"-1\">"$'\n'
            WIKI_SETTINGS_HTML+="                    <svg viewBox=\"0 0 20 16\" width=\"20\" height=\"16\" aria-hidden=\"true\"><rect x=\"0.5\" y=\"0.5\" width=\"19\" height=\"15\" fill=\"none\" stroke=\"currentColor\"/><rect x=\"12\" y=\"4\" width=\"5\" height=\"8\" fill=\"currentColor\"/></svg>"$'\n'
